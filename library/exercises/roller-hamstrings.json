{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "roller-hamstrings",
  "name": "Foam Roller Hamstring Roll",
  "otherNames": ["Foam Roll Hamstrings"],
  "category": "Mobility",
  "focus": "Hamstrings (back of the thighs)",
  "collections": ["Stretches", "Warm-up"],
  "equipment": ["Foam roller"],
  "muscles": {"shoulders": 1, "triceps": 1, "core": 1},
  "stretches": ["backThigh"],
  "description": "Sitting with a foam roller under the backs of your thighs and your hands behind you, lift your hips and roll slowly from just above the knees toward the hips and back.",
  "source": {
    "url": "https://www.healthline.com/health/fitness-exercise/foam-rolling-how-to",
    "title": "Healthline: Foam rolling, how to"
  },
  "setup": ["Sit with your legs straight, a foam roller under the backs of your thighs.", "Hands on the floor behind you; heels off the floor."],
  "cues": ["Move with your arms; legs relaxed.", "Slow, even rolls.", "Stop short of the back of the knee."],
  "prescription": {
    "time": "30–60 seconds",
    "note": "Roll slowly, about 2 seconds each way. Pause on a tender spot for a few breaths; skip anything sharp or painful, and avoid rolling right over a joint."
  },
  "keyframes": [
    {
      "name": "Roller above your knees",
      "cue": "Hands behind you, lift your hips, the roller just above the backs of your knees.",
      "camera": 90,
      "durationMs": 2200,
      "holdMs": 200,
      "phase": "rep",
      "anchor": "handR",
      "touch": [
        {
          "point": "thighR",
          "adjust": "hipR"
        },
        {
          "point": "thighL",
          "adjust": "hipL"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "root": [-41, 0, 0],
        "shoulderL": [-25, 0, 0],
        "shoulderR": [-25, 0, 0],
        "hipL": [50, 0, 0],
        "hipR": [50, 0, 0],
        "ankleL": 20,
        "ankleR": 20
      }
    },
    {
      "name": "Roll toward your hips",
      "cue": "Push with your hands to roll up toward your hips, then back.",
      "camera": 90,
      "durationMs": 2200,
      "holdMs": 200,
      "phase": "rep",
      "anchor": "handR",
      "touch": [
        {
          "point": "thighR",
          "adjust": "hipR"
        },
        {
          "point": "thighL",
          "adjust": "hipL"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "root": [-44, 0, 0],
        "shoulderL": [-72, 0, 0],
        "shoulderR": [-72, 0, 0],
        "hipL": [50, 0, 0],
        "hipR": [50, 0, 0],
        "ankleL": 20,
        "ankleR": 20
      }
    }
  ],
  "props": [
    {
      "type": "roller",
      "z": 100
    }
  ],
  "startPosition": "seated",
  "endPosition": "seated",
  "measure": "time",
  "defaults": {
    "seconds": 45
  }
}
