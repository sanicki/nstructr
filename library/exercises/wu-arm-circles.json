        "shoulderR": 540,
        "armDepthL": 72,
        "armDepthR": 72
      },
      "ease": "linear",
      "phase": "rep"
    }
  ],
  "direction": {
    "labels": {
      "A": "Forward",
      "B": "Backward"
    }
  },
  "repName": "circle",
  "measure": "reps",
