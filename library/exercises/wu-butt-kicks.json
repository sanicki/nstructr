{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "wu-butt-kicks",
  "name": "Butt Kicks",
  "otherNames": ["Heel Kicks", "Standing Butt Kicks"],
  "category": "Cardio",
  "focus": "Thighs and hamstrings",
  "collections": ["Warm-up"],
  "equipment": [],
  "description": "In place, kick one heel up toward your seat and then the other, in a quick rhythm with arms bent. Jog to make it harder.",
  "source": {
    "url": "https://www.acefitness.org/resources/pros/expert-articles/6886/dynamic-warm-ups-and-sticking-finishes/",
    "title": "ACE: Dynamic warm-ups"
  },
  "setup": ["Stand tall, arms bent at your sides."],
  "cues": ["Heel toward your seat.", "Light on your feet.", "Speed up when warm."],
  "prescription": {
    "reps": "20–30 (both legs = 2)",
    "note": "Move slowly and smoothly, within a comfortable range."
  },
  "keyframes": [
    {
      "name": "Right heel up",
      "cue": "Kick your right heel up toward your seat.",
      "camera": 90,
      "durationMs": 500,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [20, 0, 0],
        "elbowL": 90,
        "shoulderR": [20, 0, 0],
        "elbowR": 90,
        "hipR": [-5, 0, 0],
        "kneeR": 130
      }
    },
    {
      "name": "Down",
      "cue": "Put it down.",
      "camera": 90,
      "durationMs": 400,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [20, 0, 0],
        "elbowL": 90,
        "shoulderR": [20, 0, 0],
        "elbowR": 90
      }
    },
    {
      "name": "Left heel up",
      "cue": "Now the left heel.",
      "camera": 90,
      "durationMs": 500,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["R"],
      "pose": {
        "shoulderL": [20, 0, 0],
        "elbowL": 90,
        "shoulderR": [20, 0, 0],
        "elbowR": 90,
        "hipL": [-5, 0, 0],
        "kneeL": 130
      }
    },
    {
      "name": "Down",
      "cue": "Put it down.",
      "camera": 90,
      "durationMs": 400,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [20, 0, 0],
        "elbowL": 90,
        "shoulderR": [20, 0, 0],
        "elbowR": 90
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 20
  },
  "repName": "kick"
}
