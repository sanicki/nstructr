{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "yoga-wheel",
  "name": "Wheel Pose",
  "sanskrit": "Urdhva Dhanurasana",
  "category": "Backbend",
  "library": "Yoga poses",
  "equipment": [
    "Yoga mat"
  ],
  "description": "Full backbend pressing up onto the hands and feet.",
  "source": {
    "url": "https://www.yogajournal.com/poses/upward-bow-or-wheel-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": [
    "Lie on your back with your knees bent and your feet flat, hip-width apart, near your hips.",
    "Place your hands beside your ears, fingers pointing toward your shoulders, elbows up."
  ],
  "facing": "right",
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Lie down with the knees bent and feet flat.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 1000,
      "anchor": "neckBase",
      "plant": [
        "L",
        "R"
      ],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": -90,
        "neck": 34,
        "hipL": -45,
        "hipR": -45,
        "kneeL": 120,
        "kneeR": 120
      },
      "phase": "setup"
    },
    {
      "name": "Wheel Pose",
      "cue": "Hands by the ears, press up into a full arch.",
      "view": "side",
      "durationMs": 2600,
      "holdMs": 5000,
      "anchor": "handR",
      "plant": [
        "L",
        "R"
      ],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        },
        {
          "point": "ankleL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": -120,
        "neck": -40,
        "shoulderL": 120,
        "shoulderR": 120,
        "hipL": 90,
        "hipR": 90,
        "kneeL": 30,
        "kneeR": 30
      },
      "phase": "rep"
    }
  ],
  "cues": [
    "Keep the knees parallel.",
    "Warm up with Bridge first."
  ],
  "anchorX": -30,
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
