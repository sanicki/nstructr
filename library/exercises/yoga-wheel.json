{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-wheel",
  "name": "Wheel Pose",
  "otherNames": ["Urdhva Dhanurasana"],
  "category": "Backbend",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Full backbend pressing up onto the hands and feet.",
  "source": {
    "url": "https://www.yogajournal.com/poses/upward-bow-or-wheel-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Lie on your back with your knees bent and your feet flat, hip-width apart, near your hips.", "Place your hands beside your ears, fingers pointing toward your shoulders, elbows up."],
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Lie down with the knees bent and feet flat.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "neckBase",
      "anchorZ": -30,
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [45, 0, 0],
        "kneeL": 90,
        "ankleL": 45,
        "hipR": [45, 0, 0],
        "kneeR": 90,
        "ankleR": 45
      }
    },
    {
      "name": "Hands by your ears",
      "cue": "Bend your elbows and put your hands by your ears, fingers toward your shoulders.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 600,
      "phase": "setup",
      "anchor": "neckBase",
      "anchorZ": -30,
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "handR",
          "adjust": "elbowR"
        },
        {
          "point": "handL",
          "adjust": "elbowL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [45, 0, 0],
        "kneeL": 90,
        "ankleL": 45,
        "hipR": [45, 0, 0],
        "kneeR": 90,
        "ankleR": 45,
        "shoulderL": [100, 0, 0],
        "shoulderR": [100, 0, 0],
        "elbowL": 130,
        "elbowR": 130
      }
    },
    {
      "name": "Wheel Pose",
      "cue": "Hands by the ears, press up into a full arch.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "handR",
      "anchorZ": -30,
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-80, 0, 0],
        "torso": [-40, 0, 0],
        "chest": [-40, 0, 0],
        "neck": [-20, 0, 0],
        "shoulderL": [160, 0, 0],
        "shoulderR": [160, 0, 0],
        "hipL": [-50, 0, 0],
        "kneeL": 40,
        "hipR": [-50, 0, 0],
        "kneeR": 40
      }
    }
  ],
  "cues": ["Keep the knees parallel.", "Warm up with Bridge first."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
