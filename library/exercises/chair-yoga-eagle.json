        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Chair Eagle Pose",
      "cue": "Cross one thigh over the other; wrap the arms, elbows up.",
      "camera": 30,
      "durationMs": 2400,
      "phase": "rep",
      "anchor": "pelvis",
