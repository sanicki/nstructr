      "reach": [],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [100, -18, 0],
        "kneeR": 85,
