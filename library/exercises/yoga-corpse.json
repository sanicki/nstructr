{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-corpse",
  "name": "Corpse Pose",
  "otherNames": ["Savasana", "Final Relaxation Pose"],
  "category": "Beginner",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Final relaxation lying flat on the back.",
  "source": {
    "url": "https://www.yogajournal.com/poses/corpse-pose-2/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Lie on your back with your legs long and slightly apart.", "Rest your arms a little away from your sides, palms up; add a blanket if you get cold."],
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Lie down with the knees bent and feet flat.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "neckBase",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [45, 0, 0],
        "kneeL": 90,
        "ankleL": 45,
        "hipR": [45, 0, 0],
        "kneeR": 90,
        "ankleR": 45
      }
    },
    {
      "name": "Corpse Pose",
      "cue": "Extend the legs, rest the arms, and relax completely.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 8000,
      "phase": "rep",
      "anchor": "neckBase",
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0]
      }
    }
  ],
  "cues": ["Let the feet fall open.", "Release effort everywhere."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
