{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-side-plank",
  "name": "Side Plank Pose",
  "otherNames": ["Vasisthasana"],
  "category": "Arm Balance",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Balance on one hand and the edge of the foot with the body in one line.",
  "source": {
    "url": "https://www.yogajournal.com/poses/side-plank-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Start in a high plank: hands under your shoulders, body in one line.", "Shift your weight onto one hand and roll onto the outer edge of that foot."],
  "keyframes": [
    {
      "name": "Plank",
      "cue": "Hands under shoulders, body in one straight line.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 900,
      "phase": "setup",
      "anchor": "handL",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [66, 0, 0],
        "shoulderL": [66, 0, 0],
        "shoulderR": [66, 0, 0],
        "hipL": [-8, 0, 0],
        "ankleL": 24,
        "hipR": [-8, 0, 0],
        "ankleR": 24
      }
    },
    {
      "name": "Roll onto the left hand",
      "camera": 90,
      "durationMs": 1300,
      "holdMs": 0,
      "phase": "setup",
      "anchor": "handL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR.side"
        },
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        }
      ],
      "pose": {
        "root": [40, -58, -68],
        "shoulderL": [33, 33, 0],
        "shoulderR": [33, 57, 0],
        "hipL": [-4, 2, 0],
        "hipR": [-4, -6.65, 0]
      },
      "quiet": true
    },
    {
      "name": "Side Plank",
      "cue": "Roll onto the left hand, stack the feet, and lift the right arm.",
      "camera": 90,
      "durationMs": 1300,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "handL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR.side"
        },
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        }
      ],
      "pose": {
        "root": [0, -66, -90],
        "shoulderL": [0, 66, 0],
        "shoulderR": [0, 114, 0],
        "hipL": [0, 4, 0],
        "hipR": [0, -13.3, 0]
      }
    }
  ],
  "cues": ["Lift the hips.", "Lower the bottom knee for support.", "Repeat on the other side."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
