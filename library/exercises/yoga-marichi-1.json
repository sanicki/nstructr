{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "yoga-marichi-1",
  "name": "Pose Dedicated to the Sage Marichi I",
  "sanskrit": "Marichyasana I",
  "category": "Binding",
  "library": "Yoga poses",
  "equipment": [
    "Yoga mat"
  ],
  "description": "Seated forward bend with one knee up and the arms binding behind the back.",
  "source": {
    "url": "https://www.yogajournal.com/poses/pose-dedicated-to-the-sage-marichi-i/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": [
    "Sit tall with both legs straight out in front of you.",
    "Bend one knee and plant that foot near the sitting bone, a little out to the side."
  ],
  "facing": "right",
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 1000,
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "hipL": -90,
        "hipR": -90,
        "shoulderL": 20,
        "shoulderR": 20
      },
      "phase": "setup"
    },
    {
      "name": "Marichyasana I",
      "cue": "Bend the right knee, wrap the arm around it, and fold forward.",
      "view": "side",
      "durationMs": 2600,
      "holdMs": 5000,
      "anchor": "pelvis",
      "plant": [
        "R"
      ],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "torso": 45,
        "hipL": -90,
        "hipR": -140,
        "kneeR": 140,
        "shoulderL": 60,
        "shoulderR": 60,
        "elbowL": -60,
        "elbowR": -60
      },
      "phase": "rep"
    }
  ],
  "cues": [
    "Lengthen before you fold.",
    "Use a strap if the hands don't meet."
  ],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
