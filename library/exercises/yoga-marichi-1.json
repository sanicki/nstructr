{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-marichi-1",
  "name": "Pose Dedicated to the Sage Marichi I",
  "otherNames": ["Marichyasana I"],
  "category": "Binding",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Seated forward bend with one knee up and the arms binding behind the back.",
  "source": {
    "url": "https://www.yogajournal.com/poses/pose-dedicated-to-the-sage-marichi-i/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with both legs straight out in front of you.", "Bend one knee and plant that foot near the sitting bone, a little out to the side."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Marichyasana I",
      "cue": "Bend the right knee, wrap the arm around it, and fold forward.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "torso": [45, 0, 0],
        "shoulderL": [-60, 0, 0],
        "elbowL": 60,
        "shoulderR": [-60, 0, 0],
        "elbowR": 60,
        "hipL": [90, 0, 0],
        "hipR": [130, 0, 0],
        "kneeR": 120,
        "ankleR": -40
      }
    }
  ],
  "cues": ["Lengthen before you fold.", "Use a strap if the hands don't meet."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
