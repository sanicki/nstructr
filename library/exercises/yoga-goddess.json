{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-goddess",
  "name": "Goddess Pose",
  "otherNames": ["Utkata Konasana", "Horse Stance"],
  "category": "Standing",
  "focus": "Thighs and inner legs",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "A wide-legged squat with the toes turned out: sink the hips until the knees bend over the ankles, arms bent up like a cactus.",
  "source": {
    "url": "https://www.yogajournal.com/poses/goddess-pose/",
    "title": "Yoga Journal: Goddess Pose"
  },
  "setup": ["Stand with your feet wide apart, toes turned out."],
  "cues": ["Knees track over your toes.", "Tailbone down, chest lifted.", "Elbows at shoulder height."],
  "keyframes": [
    {
      "name": "Step wide",
      "cue": "Feet wide, toes turned out.",
      "camera": 0,
      "durationMs": 2000,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        }
      ],
      "pose": {
        "hipL": [0, 30, 45],
        "hipR": [0, 30, 45]
      }
    },
    {
      "name": "Goddess Pose",
      "cue": "Bend your knees wide, arms up like a cactus.",
      "camera": 0,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 90, -90],
        "elbowL": 90,
        "shoulderR": [0, 90, -90],
        "elbowR": 90,
        "hipL": [0, 70, 90],
        "kneeL": 90,
        "hipR": [0, 70, 90],
        "kneeR": 90
      }
    }
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "prescription": {
    "reps": "hold 30 seconds",
    "note": "Breathe slowly and evenly; come out of the pose if anything pinches."
  }
}
