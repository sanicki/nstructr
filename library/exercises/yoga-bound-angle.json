{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-bound-angle",
  "name": "Bound Angle Pose",
  "otherNames": ["Baddha Konasana", "Butterfly Pose", "Cobbler's Pose"],
  "category": "Forward Bend",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {"lowerBack": 1},
  "stretches": ["frontThigh", "glutes"],
  "description": "Seated hip opener with the soles of the feet together and the knees dropping out to the sides.",
  "source": {
    "url": "https://www.yogajournal.com/poses/bound-angle-pose-2/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with your legs straight out in front of you.", "Bend your knees, bring the soles of your feet together and draw your heels in toward you."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Bend the knees",
      "cue": "Draw the heels in toward you.",
      "camera": 45,
      "durationMs": 1200,
      "holdMs": 0,
      "phase": "setup",
      "quiet": true,
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [125, 25, 25],
        "kneeL": 125,
        "hipR": [125, 25, 25],
        "kneeR": 125
      }
    },
    {
      "name": "Bound Angle Pose",
      "cue": "Bring the soles together and let the knees fall open.",
      "camera": 0,
      "durationMs": 1600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "touch": [],
      "pose": {
        "shoulderL": [0, 26.6, -90],
        "elbowL": 6,
        "shoulderR": [0, 26.6, -90],
        "elbowR": 6,
        "hipL": [95, 55, 90],
        "kneeL": 150,
        "hipR": [95, 55, 90],
        "kneeR": 150
      },
      "reach": [
        {
          "hand": "handR",
          "to": "footR"
        },
        {
          "hand": "handL",
          "to": "footL"
        }
      ]
    }
  ],
  "cues": ["Hold the feet and sit up tall.", "Let the knees release without forcing them down."],
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
