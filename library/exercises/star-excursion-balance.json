  "name": "Star Excursion Balance",
  "otherNames": ["Star Excursion Balance Test"],
  "category": "Balance",
  "equipment": [],
  "muscles": {"core": 1, "frontThigh": 2, "glutes": 2, "backThigh": 1, "lowerLegs": 2},
  "description": "Single-leg balance and reach: standing on one leg, reach the other foot out in eight directions around you, like the points of a star, tapping the floor lightly each time and coming back to the middle.",
  "source": {
    "url": "https://youtu.be/UoMSMdMKfBY",
    "title": "Star Excursion Balance Exercise",
    "note": "Built from the video's title and description. Poses are a stick-figure approximation of the standard eight-direction sequence. In clinical terms the reaches are anterior, anteromedial, medial, posteromedial, posterior, posterolateral, lateral and anterolateral."
  },
  "setup": ["Stand on one leg with the knee slightly bent, hands on your hips.", "Picture a star on the floor around your standing foot: forward, back, both sides and the four diagonals in between."],
  "cues": ["Keep the standing heel down the whole time.", "Tap the floor lightly with your toes; don't put weight on the reaching foot.", "Bend the standing knee to reach further, but stay in control.", "Come back to the middle between every reach, without putting the foot down."],
  "prescription": {
    "reps": "3 rounds each leg",
    "note": "The video description doesn't state reps; three rounds per leg is a common starting point."
  },
  "bilateral": {
    "labels": {
      "L": "Left leg",
      "R": "Right leg"
    }
  },
