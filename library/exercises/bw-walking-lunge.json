        "kneeL": 88,
        "ankleL": -3,
        "hipR": [4, 0, 0],
        "kneeR": 100,
        "ankleR": 40
      }
    },
    {
      "name": "Stand up",
      "cue": "Push up and bring your feet together.",
      "camera": 90,
