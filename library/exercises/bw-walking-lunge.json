        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4
      }
    },
    {
      "name": "Step forward with the left",
      "cue": "Now step forward with your left foot and lower.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "toeR",
      "plant": ["L"],
      "touch": [
        {
          "point": "toeR",
