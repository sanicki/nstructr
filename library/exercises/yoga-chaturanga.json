{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-chaturanga",
  "name": "Chaturanga",
  "otherNames": ["Chaturanga Dandasana", "Four-Limbed Staff Pose", "Low Plank"],
  "category": "Arm Balance",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Low plank with the elbows bent to 90 degrees and the body in one line.",
  "source": {
    "url": "https://www.yogajournal.com/poses/four-limbed-staff-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Start in a high plank: hands under your shoulders, legs straight, body in one line.", "Shift a little forward onto your toes before you lower."],
  "keyframes": [
    {
      "name": "Plank",
      "cue": "Hands under shoulders, body in one straight line.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 900,
      "phase": "setup",
      "anchor": "handR",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [66, 0, 0],
        "shoulderL": [66, 0, 0],
        "shoulderR": [66, 0, 0],
        "hipL": [-8, 0, 0],
        "ankleL": 24,
        "hipR": [-8, 0, 0],
        "ankleR": 24
      }
    },
    {
      "name": "Chaturanga",
      "cue": "Lower with the elbows hugging in until the upper arms are level.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "handR",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [84, 0, 0],
        "shoulderL": [-35, 0, 0],
        "elbowL": 95,
        "shoulderR": [-35, 0, 0],
        "elbowR": 95,
        "hipL": [-7.5, 0, 0],
        "ankleL": 11,
        "hipR": [-7.5, 0, 0],
        "ankleR": 11
      }
    }
  ],
  "cues": ["Stop when the shoulders reach elbow height.", "Keep the hips level with the shoulders."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
