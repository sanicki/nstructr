    "title": "Shift Movement Science: Medball V-up passes",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Lie on your back, arms overhead.", "Squeeze a light medicine ball between your feet."],
  "cues": ["Fold up from your middle.", "Hand the ball over at the top.", "Lower slowly; low back stays down."],
  "prescription": {
    "reps": "6–10",
    "note": "One rep passes the ball to your hands and back to your feet. Lower slowly; keep your low back on the floor."
  },
