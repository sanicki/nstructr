{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "ring-inner-thigh-squeeze",
  "name": "Pilates Ring Inner Thigh Squeeze",
  "otherNames": ["Magic Circle Inner Thigh Squeeze", "Supine Adductor Squeeze"],
  "category": "Strength",
  "focus": "Inner thighs and core",
  "collections": ["Pilates"],
  "equipment": ["Pilates ring"],
  "description": "Lying on your back with your knees bent and a Pilates ring between your thighs, squeeze the ring with your inner thighs, hold, and release slowly.",
  "source": {
    "url": "https://blog.alomoves.com/movement/12-pilates-ring-exercises-for-beginners",
    "title": "Alo Moves: Pilates ring exercises for beginners"
  },
  "setup": ["Lie on your back, knees bent, feet flat and hip-width apart.", "Place the ring between your thighs, just above your knees."],
  "cues": ["Lower back stays gently on the mat.", "Squeeze with the inner thighs.", "Release with control."],
  "prescription": {
    "reps": "15–20",
    "note": "Hold each squeeze for a breath; release slowly."
  },
  "keyframes": [
    {
      "name": "Ring between your knees",
      "cue": "Lie on your back, knees bent, the ring just above your knees.",
      "camera": 20,
      "durationMs": 1200,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "neckBase",
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [58, 16, 0],
        "kneeL": 116,
        "ankleL": 32,
        "hipR": [58, 16, 0],
        "kneeR": 116,
        "ankleR": 32
      }
    },
    {
      "name": "Squeeze",
      "cue": "Press your knees in to squeeze the ring; back stays down.",
      "camera": 20,
      "durationMs": 1200,
      "holdMs": 800,
      "phase": "rep",
      "anchor": "neckBase",
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [58, 8, 0],
        "kneeL": 116,
        "ankleL": 32,
        "hipR": [58, 8, 0],
        "kneeR": 116,
        "ankleR": 32
      }
    }
  ],
  "props": [
    {
      "type": "ring",
      "from": "kneeL",
      "to": "kneeR"
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 15
  }
}
