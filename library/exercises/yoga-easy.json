{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-easy",
  "name": "Easy Pose",
  "otherNames": ["Sukhasana", "Cross-Legged Pose"],
  "category": "Beginner",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Simple cross-legged seat with a tall spine.",
  "source": {
    "url": "https://www.yogajournal.com/poses/easy-pose-3/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit on the floor, or on a folded blanket so your hips are above your knees.", "Cross your shins with each foot under the opposite knee."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Easy Pose",
      "cue": "Cross the shins, rest the hands on the knees, and sit tall.",
      "camera": 0,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR.side"
        },
        {
          "point": "kneeL",
          "adjust": "hipL.side"
        },
        {
          "point": "handR",
          "adjust": "shoulderR.side"
        },
        {
          "point": "handL",
          "adjust": "shoulderL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 30.8, -90],
        "elbowL": 18,
        "shoulderR": [0, 30.8, -90],
        "elbowR": 18,
        "hipL": [90, 90, 180],
        "kneeL": 155,
        "ankleL": 92,
        "hipR": [90, 90, 180],
        "kneeR": 155,
        "ankleR": 92
      }
    }
  ],
  "cues": ["Sit on a blanket if the knees are high.", "Switch the cross of the legs regularly."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
