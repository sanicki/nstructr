{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "yoga-easy",
  "name": "Easy Pose",
  "sanskrit": "Sukhasana",
  "category": "Beginner",
  "library": "Yoga poses",
  "equipment": [
    "Yoga mat"
  ],
  "description": "Simple cross-legged seat with a tall spine.",
  "source": {
    "url": "https://www.yogajournal.com/poses/easy-pose-3/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "facing": "right",
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 1000,
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "hipL": -90,
        "hipR": 270,
        "shoulderL": 20,
        "shoulderR": 20
      },
      "phase": "setup"
    },
    {
      "name": "Easy Pose",
      "cue": "Cross the shins, rest the hands on the knees, and sit tall.",
      "view": "front",
      "durationMs": 2600,
      "holdMs": 5000,
      "anchor": "pelvis",
      "plant": [
        "L",
        "R"
      ],
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "hipL": -88,
        "hipR": 88,
        "kneeL": -178,
        "kneeR": 178,
        "shoulderL": -22,
        "shoulderR": 22,
        "elbowL": 18,
        "elbowR": -18
      },
      "phase": "rep"
    }
  ],
  "cues": [
    "Sit on a blanket if the knees are high.",
    "Switch the cross of the legs regularly."
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}