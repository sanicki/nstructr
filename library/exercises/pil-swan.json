{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "pil-swan",
  "name": "Swan Prep",
  "category": "Pilates",
  "focus": "Back extensors",
  "collections": ["Pilates"],
  "equipment": ["Yoga mat"],
  "muscles": {"upperBack": 2, "lowerBack": 3, "triceps": 1, "glutes": 1},
  "stretches": ["chest", "core"],
  "description": "Lying on your front with hands under your shoulders, lengthen and lift your chest into a gentle back extension, then lower.",
  "source": {
    "url": "https://onlinepilatesclasses.com/pilates-exercises/mat-exercises/mat-swan-prep/",
    "title": "Swan Prep on the Mat (Online Pilates Classes)",
    "note": "Classic Pilates mat exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Lie face down with your hands under your shoulders and legs together."],
  "cues": ["Lengthen first, then lift; think of reaching your head forward.", "Keep your hips on the mat.", "Lift only as high as feels comfortable in your lower back."],
  "prescription": {
    "reps": "5–6",
    "note": "Move with your breath, slowly and with control."
  },
  "keyframes": [
    {
      "name": "Lie on your front",
      "cue": "Hands under your shoulders.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "pelvis",
      "reach": [
        {
          "hand": "handR",
          "to": "shoulderR",
          "dz": 12,
          "dy": 4
        },
        {
          "hand": "handL",
          "to": "shoulderL",
          "dz": 12,
          "dy": 4
        }
      ],
      "pose": {
        "root": [90, 0, 0],
        "neck": [-34, 0, 0],
        "shoulderL": [-40, 15, 0],
        "elbowL": 110,
        "shoulderR": [-40, 15, 0],
        "elbowR": 110,
        "ankleL": 90,
        "ankleR": 90
      }
    },
    {
      "name": "Lift your chest",
      "cue": "Press gently and lift your chest.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 800,
      "phase": "rep",
      "anchor": "pelvis",
      "keep": ["handL", "handR"],
      "pose": {
        "root": [90, 0, 0],
        "torso": [-22, 0, 0],
        "chest": [-14, 0, 0],
        "neck": [-20, 0, 0],
        "shoulderL": [-40, 15, 0],
        "elbowL": 110,
        "shoulderR": [-40, 15, 0],
        "elbowR": 110,
        "ankleL": 90,
        "ankleR": 90
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
  "repName": "rep"
}
