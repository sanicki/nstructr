  "otherNames": ["Back Rack Reverse Lunge"],
  "category": "Strength",
  "focus": "Thighs and glutes",
  "collections": ["Free weights"],
  "equipment": ["Barbell"],
  "muscles": {"lowerBack": 1, "core": 1, "frontThigh": 3, "glutes": 2, "backThigh": 1, "lowerLegs": 2},
  "description": "With a barbell across your upper back, step one foot back and lower until both knees are bent, then push through the front foot to stand.",
