  "cues": ["Step back, not out to the side.", "Front knee over the ankle.", "Chest up; push through the front heel."],
  "prescription": {
    "reps": "8–12 each leg",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
