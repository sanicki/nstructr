{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-half-lord-fishes",
  "name": "Half Lord of the Fishes Pose",
  "sanskrit": "Ardha Matsyendrasana",
  "category": "Beginner",
  "library": "Yoga",
  "equipment": ["Yoga mat"],
  "description": "Seated twist with one knee up and the opposite elbow hooked outside it.",
  "source": {
    "url": "https://www.yogajournal.com/poses/half-lord-of-the-fishes-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with your legs straight out in front of you.", "Bend one knee and step that foot over the other leg, beside the opposite knee."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Draw the right knee in",
      "cue": "Bend the right knee and plant the foot.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [130, 0, 0],
        "kneeR": 120,
        "ankleR": -45
      }
    },
    {
      "name": "Half Lord of the Fishes",
      "cue": "Cross the right foot over, hook the left elbow outside the knee, and twist.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        }
      ],
      "pose": {
        "shoulderL": [60, 0, 0],
        "elbowL": 80,
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 30, 90],
        "kneeL": 145,
        "ankleL": 90,
        "hipR": [130, 0, 0],
        "kneeR": 120,
        "ankleR": -45
      }
    },
    {
      "name": "Right knee back up",
      "cue": "Bring the right knee back up, foot planted, before straightening the leg.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "finish",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [130, 0, 0],
        "kneeR": 120,
        "ankleR": -45
      }
    }
  ],
  "cues": ["Lengthen up before you twist.", "Turn from the belly, not the neck."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
