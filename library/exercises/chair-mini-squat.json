    {
      "name": "Bend your knees",
      "cue": "Slowly bend your knees, keeping your back straight.",
      "view": "side",
      "durationMs": 2000,
      "holdMs": 400,
      "anchor": "ankleL",
      "plant": [
        "L",
        "R"
      ],
      "pose": {
        "torso": 14,
        "hipL": -42,
        "hipR": -42,
        "kneeL": 58,
        "kneeR": 58,
        "shoulderL": -40,
        "shoulderR": -40,
        "elbowL": -20,
        "elbowR": -20
      },
      "reach": [
        {
          "hand": "handL",
          "to": "chair"
        },
        {
          "hand": "handR",
          "to": "chair"
        }
