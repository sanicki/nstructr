{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "chair-mini-squat",
  "name": "Mini-Squat with Chair",
  "category": "Strength",
  "focus": "Thighs and glutes",
  "library": "Chair-based",
  "equipment": [
    "Chair"
  ],
  "description": "A supported half squat: holding the back of a chair, bend your knees a little way and come back up, squeezing your buttocks.",
  "source": {
    "url": "https://www.nhs.uk/live-well/exercise/strength-and-flexibility-exercises/strength-exercises/",
    "title": "NHS: strength exercises (mini-squats)",
    "note": "Stick-figure approximation."
  },
  "setup": [
    "Stand behind a sturdy chair with your hands on its back.",
    "Feet hip-width apart."
  ],
  "cues": [
    "Bend only as far as is comfortable, knees facing forward.",
    "Keep your back straight.",
    "Squeeze your buttocks as you come up."
  ],
  "prescription": {
    "reps": "5",
    "note": "Repeat 5 times and build up gradually. Do these strength exercises at least twice a week."
  },
  "facing": "right",
  "keyframes": [
