      "name": "Stand tall",
      "cue": "Hands on the chair back.",
      "view": "side",
      "durationMs": 1800,
      "holdMs": 300,
      "anchor": "ankleL",
      "plant": [
        "L",
        "R"
      ],
      "pose": {
        "shoulderL": -40,
        "shoulderR": -40,
        "elbowL": -20,
        "elbowR": -20
      },
      "reach": [
        {
          "hand": "handL",
          "to": "chair"
        },
        {
          "hand": "handR",
          "to": "chair"
        }
      ],
