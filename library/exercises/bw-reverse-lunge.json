{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bw-reverse-lunge",
  "name": "Reverse Lunge",
  "otherNames": ["Backward Lunge", "Step-Back Lunge"],
  "category": "Strength",
  "focus": "Thighs and glutes",
  "collections": ["Bodyweight"],
  "equipment": [],
  "description": "Single-leg strength and balance: step one foot back and lower until both knees bend to about 90°, then step back up.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/319/reverse-lunge/",
    "title": "Reverse Lunge (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Stand tall with your hands on your hips."],
  "cues": ["Step back far enough that your front knee stays over your ankle.", "Lower straight down; keep your torso upright.", "Push through the front heel to come back up.", "Hold a wall or chair for balance if you need it."],
  "prescription": {
    "reps": "8–12 each leg",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
  "keyframes": [
    {
      "name": "Stand tall",
      "cue": "Hands on your hips.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [-27.5, 0, 0],
        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4
      }
    },
    {
      "name": "Lift the foot",
      "cue": "Shift onto your left leg and lift your right foot.",
      "camera": 90,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [-27.5, 0, 0],
        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4,
        "hipL": [8, 0, 0],
        "kneeL": 10,
        "ankleL": -2,
        "hipR": [-10, 0, 0],
        "kneeR": 55,
        "ankleR": 20
      }
    },
    {
      "name": "Step back and lower",
      "cue": "Place your right toes behind you and bend both knees.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "shoulderL": [-27.5, 0, 0],
        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4,
        "hipL": [85, 0, 0],
        "kneeL": 88,
        "ankleL": -3,
        "hipR": [4.1, 0, 0],
        "kneeR": 100,
        "ankleR": 40
      }
    },
    {
      "name": "Push back up",
      "cue": "Drive through your front heel and lift the back foot.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [-27.5, 0, 0],
        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4,
        "hipL": [8, 0, 0],
        "kneeL": 10,
        "ankleL": -2,
        "hipR": [-10, 0, 0],
        "kneeR": 55,
        "ankleR": 20
      }
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Right leg back",
      "R": "Left leg back"
    }
