{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "core-side-plank",
  "name": "Forearm Side Plank",
  "otherNames": ["Elbow Side Plank"],
  "category": "Core",
  "focus": "Side of the core",
  "collections": ["Core"],
  "equipment": [],
  "description": "Works the obliques: propped on one forearm with your legs stacked, lift your hips so your body makes a straight line.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/303/side-plank/",
    "title": "Side Plank (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Lie on your left side, propped on your left forearm, elbow under your shoulder, legs stacked."],
  "cues": ["Lift from the bottom hip.", "Keep your head, hips and feet in line.", "Easier: bend your knees and keep them down."],
  "prescription": {
    "reps": "Hold 15–30 s each side",
    "note": "Breathe steadily; build up the hold time gradually."
  },
  "keyframes": [
    {
      "name": "Prop on your forearm",
      "cue": "Elbow under your shoulder, hips on the floor.",
      "camera": 0,
      "durationMs": 2000,
      "holdMs": 600,
      "phase": "setup",
      "anchor": "elbowL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        },
        {
          "point": "ankleR",
          "adjust": "hipR.side"
        }
      ],
      "pose": {
        "root": [0, -55, 0],
        "shoulderL": [0, 55, 0],
        "elbowL": 90,
        "shoulderR": [0, -20, -90],
        "elbowR": 60,
        "hipL": [0, -32.1, 0],
        "hipR": [0, 25, 0]
      }
    },
    {
      "name": "Lift your hips",
      "cue": "Raise your hips and hold, top arm reaching up.",
      "camera": 0,
      "durationMs": 2000,
      "holdMs": 20000,
      "phase": "rep",
      "anchor": "elbowL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL.side"
        },
        {
          "point": "ankleR",
          "adjust": "hipR.side"
        }
      ],
      "pose": {
        "root": [0, -77.6, 0],
        "shoulderL": [0, 77.6, 0],
        "elbowL": 90,
        "shoulderR": [0, 102, -90],
        "hipL": [0, 3.6, 0],
        "hipR": [0, -12.6, 0]
      }
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left side down",
      "R": "Right side down"
    }
  },
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 20
  },
  "repName": "rep"
}
