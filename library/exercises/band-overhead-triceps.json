{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "band-overhead-triceps",
  "name": "Band Overhead Triceps Extension",
  "otherNames": ["Overhead Banded Triceps Extension"],
  "category": "Core",
  "focus": "Backs of the arms",
  "collections": ["Resistance band"],
  "equipment": ["Resistance band"],
  "muscles": {"shoulders": 1, "triceps": 3, "core": 1},
  "description": "With one end of the band under your back foot, hold the other end behind your head with elbows pointing up, then straighten your arms overhead.",
  "source": {
    "url": "https://www.muscleandstrength.com/exercises/overhead-banded-tricep-extension",
    "title": "Overhead Banded Tricep Extension (Muscle & Strength)",
    "note": "From your full-body routine, described in our own words. Stick-figure approximation."
  },
  "setup": ["Step your right foot back onto one end of the band.", "Hold the other end with both hands behind your head, elbows pointing to the ceiling."],
  "cues": ["Keep your elbows pointing up and close to your head.", "Only your forearms move.", "Lower behind your head with control; keep your core tight."],
  "prescription": {
    "reps": "12–15",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
  "keyframes": [
    {
      "name": "Hands behind your head",
      "cue": "Elbows up, band taut.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "shoulderL": [170, 0, 0],
        "elbowL": 150,
        "shoulderR": [170, 0, 0],
        "elbowR": 150,
        "hipL": [14, 0, 0],
        "ankleL": 14,
        "hipR": [-14, 0, 0],
        "ankleR": -14
      }
    },
    {
      "name": "Extend",
      "cue": "Straighten your arms overhead.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "shoulderL": [176, 0, 0],
        "elbowL": 2,
        "shoulderR": [176, 0, 0],
        "elbowR": 2,
        "hipL": [14, 0, 0],
        "ankleL": 14,
        "hipR": [-14, 0, 0],
        "ankleR": -14
      }
    }
  ],
  "props": [
    {
      "type": "band",
      "from": "footR",
      "to": "handR"
    }
