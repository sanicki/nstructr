{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-hip-marching",
  "name": "Seated Hip Marching",
  "otherNames": ["Seated Marching"],
  "category": "Strength",
  "focus": "Hips and thighs",
  "collections": ["Chair-based"],
  "equipment": ["Chair"],
  "muscles": {"core": 1, "frontThigh": 3},
  "description": "Strengthens the hips and thighs from a chair: sitting tall and holding the sides of the seat, lift one knee, then place the foot down with control.",
  "source": {
    "url": "https://www.nhs.uk/live-well/exercise/sitting-exercises/",
    "title": "NHS: sitting exercises (hip marching)",
    "note": "Stick-figure approximation."
  },
  "setup": ["Sit upright on a solid chair without leaning on its back.", "Hold on to the sides of the seat."],
  "cues": ["Lift the knee only as far as is comfortable.", "Put the foot down with control.", "Alternate legs."],
  "prescription": {
    "reps": "5 each leg",
    "note": "Build up the repetitions gradually. Do these exercises at least twice a week."
  },
  "keyframes": [
    {
      "name": "Sit tall",
      "cue": "Hands on the sides of the seat, feet flat.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Lift your left knee",
      "cue": "Raise your left knee with it bent, then lower the foot.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [118, 0, 0],
        "kneeL": 108,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "z": -12
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left leg",
      "R": "Right leg"
    }
  },
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
  "repName": "rep"
}
