{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "wu-hip-circles",
  "name": "Standing Hip Circles",
  "category": "Mobility",
  "focus": "Hips and lower back",
  "library": "Warm-up",
  "equipment": [],
  "description": "A hip and lower-back warm-up: hands on your hips, circle your hips in a wide, smooth loop one way, then the other.",
  "source": {
    "url": "https://support.runna.com/en/articles/8837242-hip-circles-exercise-tutorial",
    "title": "Hip Circles tutorial (Runna)",
    "note": "From your full-body routine, described in our own words. Stick-figure approximation."
  },
  "setup": [
    "Stand with your feet slightly wider than hip-width, hands on your hips."
  ],
  "cues": [
    "Drive the hips forward, to the side, back and around.",
    "Keep your head and shoulders fairly still.",
    "Do one direction, pause, then reverse."
  ],
  "prescription": {
    "reps": "10 each direction",
    "note": "About 30 seconds. From the front you see the side-to-side part of each circle; the compass shows where your hips are."
  },
  "facing": "right",
