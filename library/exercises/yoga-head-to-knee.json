{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-head-to-knee",
  "name": "Head-to-Knee Pose",
  "otherNames": ["Janu Sirsasana", "Half Butterfly"],
  "category": "Forward Bend",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {},
  "stretches": ["lowerBack", "backThigh"],
  "description": "Seated forward bend over one straight leg with the other foot against the inner thigh.",
  "source": {
    "url": "https://www.yogajournal.com/poses/head-to-knee-forward-bend/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with both legs straight out in front of you.", "Bend one knee and rest that foot against the inner thigh of the straight leg."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Draw the left knee in",
      "cue": "Bend the left knee and bring the foot toward the thigh.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["L"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [130, 0, 0],
        "kneeL": 120,
        "ankleL": -45,
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Head-to-Knee Pose",
      "cue": "Bend the left knee, then fold over the straight right leg.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "pose": {
        "torso": [62, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [150, 0, 0],
        "shoulderR": [150, 0, 0],
        "hipL": [90, 45, 90],
        "kneeL": 140,
        "ankleL": 90,
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Left knee back up",
      "cue": "Bring the left knee back up, foot planted, before straightening the leg.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "finish",
      "anchor": "pelvis",
      "plant": ["L"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [130, 0, 0],
        "kneeL": 120,
        "ankleL": -45,
        "hipR": [90, 0, 0]
      }
    }
  ],
  "cues": ["Fold from the hips.", "Keep the straight leg active."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
