{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-staff",
  "name": "Staff Pose",
  "otherNames": ["Dandasana"],
  "category": "Beginner",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Seated with the legs straight out and the spine tall.",
  "source": {
    "url": "https://www.yogajournal.com/poses/staff-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit on the floor with your legs straight out in front of you and together.", "Put your hands on the floor beside your hips."],
  "keyframes": [
    {
      "name": "Sit down",
      "cue": "Sit with the knees bent.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [120, 0, 0],
        "kneeL": 60,
        "ankleL": 60,
        "hipR": [120, 0, 0],
        "kneeR": 60,
        "ankleR": 60
      }
    },
    {
      "name": "Staff Pose",
      "cue": "Straighten the legs, flex the feet, and press the hands down.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    }
  ],
  "cues": ["Sit on a blanket if the back rounds.", "Lift through the crown."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
