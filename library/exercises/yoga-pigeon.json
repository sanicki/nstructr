{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "yoga-pigeon",
  "name": "Pigeon Pose",
  "sanskrit": "Eka Pada Rajakapotasana",
  "category": "Hip-Opening",
  "library": "Yoga poses",
  "equipment": [
    "Yoga mat"
  ],
  "description": "Hip opener with the front shin on the floor and the back leg extended behind.",
  "source": {
    "url": "https://www.yogajournal.com/poses/one-legged-king-pigeon-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "facing": "right",
  "keyframes": [
    {
      "name": "Tabletop",
      "cue": "Come to hands and knees, wrists under shoulders.",
      "view": "side",
      "durationMs": 1600,
      "holdMs": 900,
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": 75,
        "shoulderL": -75,
        "shoulderR": -75,
        "hipL": -75,
        "hipR": -75,
        "kneeL": 90,
        "kneeR": 90,
        "ankleL": 90,
        "ankleR": 90
      },
      "phase": "setup"
    },
    {
      "name": "Right knee forward",
      "cue": "Slide the right knee forward behind the right wrist.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 500,
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "kneeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "root": 75,
        "shoulderL": -75,
        "shoulderR": -75,
        "ankleL": 90,
        "ankleR": 90,
        "hipL": -75,
        "kneeL": 90,
        "hipR": -130,
        "kneeR": 130
      },
      "phase": "setup"
    },
    {
      "name": "Pigeon Pose",
      "cue": "Bring the right knee forward, extend the left leg back, and lift the chest.",
      "view": "side",
      "durationMs": 2600,
      "holdMs": 5000,
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": -8,
        "hipR": -90,
        "kneeR": 180,
        "ankleR": 90,
        "hipL": 90,
        "ankleL": 90,
        "shoulderL": 14,
        "shoulderR": 14
      },
      "phase": "rep"
    },
    {
      "name": "Back to hands and knees",
      "cue": "Lift the hips and bring the right knee back.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 500,
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "kneeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "root": 75,
        "shoulderL": -75,
        "shoulderR": -75,
        "ankleL": 90,
        "ankleR": 90,
        "hipL": -75,
        "kneeL": 90,
        "hipR": -130,
        "kneeR": 130
      },
      "phase": "finish"
    }
  ],
  "cues": [
    "Keep the hips level.",
    "Support the front hip with a blanket if needed."
  ],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}