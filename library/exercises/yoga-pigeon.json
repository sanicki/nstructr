{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-pigeon",
  "name": "Pigeon Pose",
  "sanskrit": "Eka Pada Rajakapotasana",
  "category": "Hip-Opening",
  "library": "Yoga",
  "equipment": ["Yoga mat"],
  "description": "Hip opener with the front shin on the floor and the back leg extended behind.",
  "source": {
    "url": "https://www.yogajournal.com/poses/one-legged-king-pigeon-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Start on your hands and knees.", "Bring one knee forward behind that wrist, with the shin angled across in front of you, and slide the other leg back."],
  "keyframes": [
    {
      "name": "Tabletop",
      "cue": "Come to hands and knees, wrists under shoulders.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 900,
      "phase": "setup",
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [75, 0, 0],
        "hipL": [75, 0, 0],
        "kneeL": 90,
        "ankleL": 90,
        "hipR": [75, 0, 0],
        "kneeR": 90,
        "ankleR": 90
      }
    },
    {
      "name": "Right knee forward",
      "cue": "Slide the right knee forward behind the right wrist.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 500,
      "phase": "setup",
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "kneeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [75, 0, 0],
        "hipL": [75, 0, 0],
        "kneeL": 90,
        "ankleL": 90,
        "hipR": [75, 0, 0],
        "kneeR": 130,
        "ankleR": 90
      }
    },
    {
      "name": "Pigeon Pose",
      "cue": "Bring the right knee forward, extend the left leg back, and lift the chest.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [-8, 0, 0],
        "shoulderL": [-33.1, 0, 0],
        "shoulderR": [-33.1, 0, 0],
        "hipL": [-90, 0, 0],
        "ankleL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 180,
        "ankleR": 90
      }
    },
    {
      "name": "Back to hands and knees",
      "cue": "Lift the hips and bring the right knee back.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 500,
      "phase": "finish",
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "kneeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [75, 0, 0],
        "hipL": [75, 0, 0],
        "kneeL": 90,
        "ankleL": 90,
        "hipR": [75, 0, 0],
        "kneeR": 130,
        "ankleR": 90
      }
    }
  ],
  "cues": ["Keep the hips level.", "Support the front hip with a blanket if needed."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
