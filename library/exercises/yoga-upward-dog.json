      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": 78,
        "torso": -38,
        "neck": -10,
        "shoulderL": -40,
        "shoulderR": -40,
        "ankleL": 101,
        "ankleR": 101
      },
      "phase": "rep"
