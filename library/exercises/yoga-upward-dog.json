{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-upward-dog",
  "name": "Upward Dog",
  "otherNames": ["Urdhva Mukha Svanasana", "Upward-Facing Dog Pose", "Up Dog"],
  "category": "Backbend",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {"shoulders": 2, "lowerBack": 2, "triceps": 2, "glutes": 1},
  "stretches": ["chest", "core", "frontThigh"],
  "description": "Backbend on straight arms with the chest lifted and the tops of the feet down.",
  "source": {
    "url": "https://www.yogajournal.com/poses/upward-facing-dog-2/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Lie on your belly with your legs straight and the tops of your feet on the floor.", "Place your hands beside your lower ribs, elbows close to your body."],
  "keyframes": [
    {
      "name": "Plank",
      "cue": "Hands under shoulders, body in one straight line.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 900,
      "phase": "setup",
      "anchor": "handR",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [66, 0, 0],
        "shoulderL": [66, 0, 0],
        "shoulderR": [66, 0, 0],
        "hipL": [-8, 0, 0],
        "ankleL": 24,
        "hipR": [-8, 0, 0],
        "ankleR": 24
      }
    },
    {
      "name": "Upward-Facing Dog",
      "cue": "Press into the hands and lift the chest and thighs.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "handR",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [78, 0, 0],
        "torso": [-38, 0, 0],
        "neck": [-10, 0, 0],
        "shoulderL": [40, 0, 0],
        "shoulderR": [40, 0, 0],
        "hipL": [-0.7, 0, 0],
        "ankleL": 101,
        "hipR": [-0.7, 0, 0],
        "ankleR": 101
      }
    }
  ],
  "cues": ["Keep the shoulders away from the ears.", "Lift the thighs off the floor."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
