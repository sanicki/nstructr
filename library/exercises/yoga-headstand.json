{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-headstand",
  "name": "Headstand",
  "otherNames": ["Salamba Sirsasana", "Supported Headstand"],
  "category": "Balancing",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "startPosition": "other",
  "endPosition": "other",
  "muscles": {"shoulders": 3, "upperBack": 2, "triceps": 1, "core": 2},
  "description": "Inversion balancing on the forearms and the crown of the head.",
  "source": {
    "url": "https://www.yogajournal.com/poses/supported-headstand/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Kneel and set your forearms down, clasping your hands with your elbows shoulder-width apart.", "Rest the crown of your head on the floor with the back of it against your hands. Learn this with a teacher."],
  "keyframes": [
    {
      "name": "Dolphin",
      "cue": "Forearms down, lift the hips high.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "elbowR",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        },
        {
          "point": "ankleL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "torso": [135, 0, 0],
        "shoulderL": [135, 0, 0],
        "elbowL": 90,
        "shoulderR": [135, 0, 0],
        "elbowR": 90,
        "hipL": [-39.8, 0, 0],
        "ankleL": -39.8,
        "hipR": [-39.8, 0, 0],
        "ankleR": -39.8
      }
    },
    {
      "name": "Supported Headstand",
      "cue": "Interlace the hands behind the head, walk in, and lift the legs.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "elbowR",
      "pose": {
        "root": [180, 0, 0],
        "shoulderL": [155, 0, 0],
        "elbowL": 115,
        "shoulderR": [155, 0, 0],
        "elbowR": 115
      }
    }
  ],
  "cues": ["Most weight goes in the forearms.", "Learn with a teacher."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
