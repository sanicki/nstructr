{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bar-dead-hang",
  "name": "Dead Hang",
  "otherNames": ["Bar Hang", "Passive Hang"],
  "category": "Mobility",
  "focus": "Grip, shoulders and spine (decompression)",
  "collections": ["Bodyweight"],
  "equipment": ["Pull-up bar"],
  "description": "Hang from a bar with straight arms and relaxed shoulders, holding for time to build grip strength and ease the shoulders and spine.",
  "source": {
    "url": "https://www.healthline.com/health/fitness-exercise/dead-hang",
    "title": "Healthline: Dead hang"
  },
  "setup": ["A sturdy pull-up bar you can reach with a small hop or a step.", "Grip it shoulder-width, palms forward."],
  "cues": ["Breathe slowly.", "Relax your legs.", "Step down before your grip fails."],
  "prescription": {
    "reps": "10–30 seconds, 2–3 times",
    "note": "Let go before your grip gives out. Feet near a step or the floor to stand on."
  },
  "keyframes": [
