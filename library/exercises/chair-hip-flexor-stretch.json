{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-hip-flexor-stretch",
  "name": "Chair Hip Flexor Stretch",
  "otherNames": ["Seated Hip Flexor Stretch"],
  "category": "Flexibility",
  "focus": "Front of the hips",
  "collections": ["Stretches", "Chair-based"],
  "equipment": ["Chair"],
  "description": "Sitting sideways near the front corner of a chair, slide the leg nearest the front of the seat back until the knee points down, and tuck your hips under to stretch the front of that hip.",
  "source": {
    "url": "https://www.health.harvard.edu/healthy-aging-and-longevity/do-you-spend-most-of-your-day-sitting-these-hip-flexor-stretches-are-for-you",
    "title": "Harvard Health: Hip flexor stretches for people who sit a lot",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Sit sideways near the front corner of a sturdy chair, the chair back beside you.", "Front foot flat on the floor."],
  "cues": ["Sit tall.", "Knee points to the floor.", "Squeeze your seat; tuck the hips."],
  "prescription": {
    "seconds": "30",
    "note": "Squeeze your seat and tuck your hips under a little to feel more."
  },
  "keyframes": [
    {
      "name": "Sit sideways",
      "cue": "Sit sideways near the front corner of the seat, both feet flat.",
      "camera": 0,
      "durationMs": 1800,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["R"],
      "reach": [],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [0, 0, -90],
        "hipR": [90, 0, 0],
        "kneeR": 90,
        "shoulderL": [-10, 10, 0],
        "elbowL": 70,
        "shoulderR": [-10, 10, 0],
        "elbowR": 70,
        "hipL": [80, 18, 0],
        "kneeL": 80
      }
    },
    {
      "name": "Leg back",
      "cue": "Slide the leg nearest the front of the chair back, knee pointing down.",
      "camera": 0,
      "durationMs": 2400,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "reach": [],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "toeL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [0, 0, -90],
        "hipR": [90, 0, 0],
        "kneeR": 90,
        "shoulderL": [-10, 10, 0],
        "elbowL": 70,
        "shoulderR": [-10, 10, 0],
        "elbowR": 70,
        "hipL": [-18, 6, 0],
        "kneeL": 70,
        "ankleL": 30
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "x": 5,
      "z": -30
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left hip",
      "R": "Right hip"
    }
  },
  "measure": "time",
  "defaults": {
    "seconds": 30
  },
  "holdStep": 1
}
