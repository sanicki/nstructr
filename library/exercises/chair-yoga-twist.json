{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-yoga-twist",
  "name": "Chair Twist",
  "otherNames": ["Seated Chair Twist"],
  "category": "Twist",
  "focus": "Spine",
  "collections": ["Yoga", "Chair-based"],
  "equipment": ["Chair"],
  "muscles": {},
  "stretches": ["lowerBack", "core"],
  "description": "A gentle seated twist on a chair: sitting tall, turn your chest to one side with the opposite hand on your knee.",
  "source": {
    "url": "https://www.yogajournal.com/yoga-101/types-of-yoga/chair-yoga-poses/",
    "title": "Yoga Journal: 13 Chair Yoga Poses You Can Do Anywhere"
  },
  "setup": ["Sit toward the front of a sturdy chair, feet flat.", "Grow tall through your spine before you turn."],
  "cues": ["Lengthen as you breathe in.", "Turn a little more as you breathe out.", "Keep both hips on the seat."],
  "prescription": {
    "reps": "hold 30 seconds",
    "note": "Breathe slowly and evenly; ease out of the pose if anything pinches."
  },
  "keyframes": [
    {
      "name": "Sit tall",
      "cue": "Feet flat, spine long.",
      "camera": 30,
      "tilt": 30,
      "durationMs": 2000,
      "holdMs": 400,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 26
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 26
        }
      ],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Chair Twist",
      "cue": "Turn to the right, left hand to your right knee.",
      "camera": 30,
      "tilt": 30,
      "durationMs": 2000,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "reach": [
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": 18,
          "dz": 24
        },
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 30,
          "dz": -24
        }
      ],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90,
        "torso": [0, 0, 25],
        "chest": [0, 0, 20],
        "neck": [0, 0, 15]
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "z": -12
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "defaults": {
    "seconds": 30
  },
  "holdStep": 1
}
