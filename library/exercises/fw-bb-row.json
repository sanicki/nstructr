{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "fw-bb-row",
  "name": "Barbell Bent-Over Row",
  "otherNames": ["Barbell Row", "Bent-Over Row"],
  "category": "Strength",
  "focus": "Upper back",
  "collections": ["Free weights"],
  "equipment": ["Barbell"],
  "muscles": {"shoulders": 2, "chest": 2, "upperBack": 3, "lowerBack": 1, "biceps": 2, "triceps": 1, "core": 1},
  "description": "Hinged forward with a flat back, pull a barbell up toward the bottom of your ribs, squeezing your shoulder blades, then lower it.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/12/bent-over-row/",
    "title": "ACE Exercise Library: Bent-Over Row"
  },
  "setup": ["Hold the barbell with an overhand grip a little wider than your shoulders.", "Soft knees, hinge forward with a flat back."],
  "cues": ["Pull the bar to your lower ribs.", "Elbows close, squeeze your shoulder blades.", "Lower with control."],
  "prescription": {
    "reps": "8–12",
    "note": "Pick a weight you can lift for every rep with good form. Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
  "keyframes": [
