      "name": "Bar hanging",
      "cue": "Hinged forward, back flat.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "torso": [58, 0, 0],
        "shoulderL": [58, 0, 0],
        "shoulderR": [58, 0, 0],
        "hipL": [14, 0, 0],
        "kneeL": 24,
        "ankleL": -10,
        "hipR": [14, 0, 0],
        "kneeR": 24,
        "ankleR": -10
      }
    },
    {
      "name": "Row",
      "cue": "Pull the bar to your lower ribs.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "torso": [58, 0, 0],
        "shoulderL": [-4, 0, 0],
        "elbowL": 66,
        "shoulderR": [-4, 0, 0],
        "elbowR": 66,
        "hipL": [14, 0, 0],
        "kneeL": 24,
        "ankleL": -10,
        "hipR": [14, 0, 0],
