{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-lotus",
  "name": "Lotus Pose",
  "otherNames": ["Padmasana"],
  "category": "Seated",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {"lowerBack": 1},
  "stretches": ["frontThigh", "glutes", "lowerLegs"],
  "description": "Cross-legged seat with each foot resting on the opposite thigh.",
  "source": {
    "url": "https://www.yogajournal.com/poses/lotus-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with your legs straight out in front of you.", "Bend one knee and ease that foot onto the top of the opposite thigh; only then the other foot."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "tilt": 30,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Lotus Pose",
      "cue": "Place each foot on the opposite thigh and rest the hands on the knees.",
      "camera": 0,
      "tilt": 30,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR.side"
        },
        {
          "point": "handL",
          "adjust": "shoulderL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 32.6, -90],
        "elbowL": 26,
        "shoulderR": [0, 32.6, -90],
        "elbowR": 26,
        "hipL": [100, 20, 90],
        "kneeL": 135,
        "hipR": [100, 20, 90],
        "kneeR": 135
      }
    }
  ],
  "cues": ["Only go as far as the knees allow.", "Try Half Lotus first."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
