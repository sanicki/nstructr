{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "yoga-lotus",
  "name": "Lotus Pose",
  "sanskrit": "Padmasana",
  "category": "Seated",
  "library": "Yoga",
  "equipment": [
    "Yoga mat"
  ],
  "description": "Cross-legged seat with each foot resting on the opposite thigh.",
  "source": {
    "url": "https://www.yogajournal.com/poses/lotus-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": [
    "Sit tall with your legs straight out in front of you.",
    "Bend one knee and ease that foot onto the top of the opposite thigh; only then the other foot."
  ],
  "facing": "right",
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "view": "side",
      "durationMs": 1500,
      "holdMs": 1000,
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "hipL": -90,
        "hipR": 270,
        "shoulderL": 20,
        "shoulderR": 20
      },
      "phase": "setup"
    },
    {
      "name": "Lotus Pose",
      "cue": "Place each foot on the opposite thigh and rest the hands on the knees.",
      "view": "front",
      "durationMs": 2600,
      "holdMs": 5000,
      "anchor": "pelvis",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "hipL": -88,
        "hipR": 88,
        "kneeL": -160,
        "kneeR": 160,
        "shoulderL": -18,
        "shoulderR": 18,
        "elbowL": 26,
        "elbowR": -26
      },
      "phase": "rep"
    }
  ],
  "cues": [
    "Only go as far as the knees allow.",
    "Try Half Lotus first."
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
