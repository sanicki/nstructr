{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "pil-leg-circles",
  "name": "Leg Circles",
  "otherNames": ["Single-Leg Circles"],
  "category": "Pilates",
  "focus": "Hips and deep core",
  "collections": ["Pilates"],
  "equipment": ["Mat"],
  "description": "Lying on your back with one leg reaching to the ceiling, draw small, smooth circles with that leg while your pelvis and back stay still on the mat. Then reverse, and switch legs.",
  "source": {
    "url": "https://onlinepilatesclasses.com/pilates-exercises/mat-exercises/mat-single-leg-circles/",
    "title": "Single Leg Circles on the Mat (Online Pilates Classes)",
    "note": "Classical Pilates mat exercise, described in our own words; also checked against Pilatesology's encyclopedia entry. Stick-figure approximation: from the side you see the leg sweep toward your head and feet, and it looks shorter as it crosses the body or swings out; the compass shows where the foot is."
  },
  "setup": ["Lie on your back, legs long, arms by your sides with palms down.", "Lift one leg straight up toward the ceiling; keep the other leg long and heavy on the mat."],
  "cues": ["Keep the circles small enough that your pelvis doesn't rock.", "Press your arms and the back of your body into the mat.", "Pause at the top of each circle, then reverse after the set.", "Tight hamstrings? Bend the lifted knee a little, or bend the bottom knee with that foot flat."],
  "prescription": {
    "reps": "5 each direction, each leg",
    "note": "Breathe out as the leg circles down, in as it comes back up."
  },
  "floorGuide": {
    "type": "star",
    "arms": 4
  },
  "bilateral": {
    "labels": {
      "L": "Right leg",
      "R": "Left leg"
    }
  },
  "direction": {
    "labels": {
      "A": "Across first",
      "B": "Out first"
    }
  },
  "repName": "circle",
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
