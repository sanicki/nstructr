{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "core-crunch",
  "name": "Crunch",
  "category": "Core",
  "focus": "Abdominals",
  "library": "Core",
  "equipment": [],
  "description": "Works the stomach muscles: lying on your back with knees bent, curl your head and shoulders up off the floor and lower slowly.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/52/crunch/",
    "title": "Crunch (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Lie on your back with your knees bent and feet flat.", "Cross your arms over your chest."],
  "cues": ["Curl up from the upper back; the lower back stays down.", "Don't pull on your neck.", "Breathe out as you curl up."],
  "prescription": {
    "reps": "8–15",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Knees bent, arms across your chest.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "neckBase",
          "dx": 22,
          "dy": 6,
          "dz": 18
        },
        {
          "hand": "handL",
          "to": "neckBase",
          "dx": -22,
          "dy": 6,
          "dz": 18
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "shoulderL": [86.3, 0, 180],
        "elbowL": 164.2,
        "shoulderR": [86.3, 0, 180],
        "elbowR": 164.2,
        "hipL": [58, 0, 0],
        "kneeL": 116,
        "ankleL": 32,
        "hipR": [58, 0, 0],
        "kneeR": 116,
        "ankleR": 32
      }
    },
    {
      "name": "Curl up",
      "cue": "Lift your head and shoulders off the floor.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 500,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "neckBase",
          "dx": 22,
          "dy": 6,
          "dz": 18
        },
        {
          "hand": "handL",
          "to": "neckBase",
          "dx": -22,
          "dy": 6,
          "dz": 18
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "chest": [32, 0, 0],
        "neck": [44, 0, 0],
        "shoulderL": [125.1, 0, 180],
        "elbowL": 162.5,
        "shoulderR": [125.1, 0, 180],
        "elbowR": 162.5,
        "hipL": [58, 0, 0],
        "kneeL": 116,
        "ankleL": 32,
        "hipR": [58, 0, 0],
        "kneeR": 116,
        "ankleR": 32
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 8
  },
  "repName": "rep"
}
