{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "ball-bridge",
  "name": "Stability Ball Bridge",
  "otherNames": ["Swiss Ball Bridge", "Straight-Leg Bridge on a Ball"],
  "category": "Strength",
  "focus": "Glutes and hamstrings",
  "collections": ["Core", "Bodyweight"],
  "equipment": ["Stability ball"],
  "description": "Lying on your back with straight legs and your heels on a stability ball, press into the ball to lift your hips until your body is straight, then lower.",
  "source": {
    "url": "https://www.bodbot.com/Exercises/797/Straight-Leg-Supine-Bridge-on-Stability-Ball",
    "title": "BodBot: Straight-leg supine bridge on a stability ball"
  },
  "setup": ["Lie on your back, arms by your sides, palms down.", "Rest your heels on the top of the ball, legs straight."],
  "cues": ["Squeeze your glutes to lift.", "Hands press the floor for balance.", "Lower slowly."],
  "prescription": {
    "reps": "10–12",
    "note": "Keep the ball still; hold at the top for a breath."
  },
  "keyframes": [
    {
      "name": "Heels on the ball",
      "cue": "Lie on your back, heels on the ball, legs straight, arms by your sides.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "neckBase",
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL"
        },
        {
          "point": "ankleR",
          "adjust": "hipR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "shoulderL": [0, 0, 0],
        "shoulderR": [0, 0, 0],
        "hipL": [35, 0, 0],
        "hipR": [35, 0, 0]
      }
    },
    {
      "name": "Lift your hips",
      "cue": "Press your heels into the ball and lift your hips until your body is straight.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 800,
      "phase": "rep",
      "anchor": "neckBase",
      "touch": [
        {
          "point": "ankleL",
          "adjust": "hipL"
        },
        {
          "point": "ankleR",
          "adjust": "hipR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        }
      ],
      "pose": {
        "root": [-107.5, 0, 0],
        "neck": [51.5, 0, 0],
        "shoulderL": [0, 0, 0],
        "shoulderR": [0, 0, 0],
        "hipL": [5, 0, 0],
        "hipR": [5, 0, 0]
      }
    }
  ],
  "props": [
    {
      "type": "ball",
      "x": 0,
      "z": 230,
      "r": 58
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 10
  }
}
