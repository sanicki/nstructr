    "title": "Back Squat (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": [
    "Set the bar across your upper back, below your neck, hands just outside your shoulders.",
    "Feet about shoulder-width apart."
  ],
  "cues": [
    "Brace your stomach before each rep.",
    "Sit down and back; keep your chest up.",
    "Knees track over your toes.",
    "Use a rack with safety bars, or learn with a coach."
  ],
  "prescription": {
    "reps": "5–8",
    "note": "Warm up with lighter sets first. Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
