{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "fw-farmers-carry",
  "name": "Farmer's Carry",
  "otherNames": ["Farmer's Walk", "Farmer Carry", "Dumbbell Farmer's Walk"],
  "category": "Strength",
  "focus": "Grip, shoulders and core",
  "collections": ["Free weights"],
  "equipment": ["Dumbbells"],
  "muscles": {"shoulders": 1, "upperBack": 3, "biceps": 3, "core": 2, "frontThigh": 1, "glutes": 1, "lowerLegs": 1},
  "description": "Hold a heavy dumbbell in each hand by your sides and walk tall with short, steady steps, without letting the weights swing.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/359/farmer-s-carry/",
    "title": "ACE Exercise Library: Farmer's Carry"
  },
  "setup": ["Stand between the dumbbells, squat down and pick them up with a firm grip.", "Stand tall, shoulders back, arms by your sides."],
  "cues": ["Chest up, shoulders down.", "Short, quick steps.", "Weights still by your sides."],
  "prescription": {
    "reps": "20–40 steps, 2–3 times",
    "note": "Pick weights heavy for you but that you can hold without leaning. Set them down with a squat, not a stoop."
  },
  "keyframes": [
    {
      "name": "Right foot forward",
      "cue": "Walk tall: step with your right foot, weights by your sides.",
      "camera": 90,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [0, 8, 0],
        "shoulderR": [0, 8, 0],
        "hipR": [15, 0, 0],
        "kneeR": 5,
        "hipL": [-12, 0, 0]
      }
    },
    {
      "name": "Left foot forward",
      "cue": "Now the left foot; short, steady steps.",
      "camera": 90,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [0, 8, 0],
        "shoulderR": [0, 8, 0],
        "hipL": [15, 0, 0],
        "kneeL": 5,
        "hipR": [-12, 0, 0]
      }
    }
  ],
  "props": [
    {
      "type": "dumbbell",
      "hand": "handL",
      "axis": "fb"
    },
    {
      "type": "dumbbell",
      "hand": "handR",
      "axis": "fb"
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 15
  },
  "repName": "step pair",
  "travel": true
}
