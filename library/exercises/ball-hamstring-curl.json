{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "ball-hamstring-curl",
  "name": "Stability Ball Hamstring Curl",
  "otherNames": ["Swiss Ball Leg Curl", "Exercise Ball Leg Curl", "Stability Ball Leg Curl"],
  "category": "Strength",
  "focus": "Hamstrings, glutes and core",
  "collections": ["Core", "Bodyweight"],
  "equipment": ["Stability ball"],
  "muscles": {"lowerBack": 1, "core": 2, "glutes": 2, "backThigh": 3, "lowerLegs": 1},
  "description": "Lying on your back with your heels on a stability ball, lift your hips, then pull your heels in to roll the ball toward you and straighten your legs to roll it back, hips up throughout.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/59/stability-ball-hamstring-curl/",
    "title": "ACE Exercise Library: Stability Ball Hamstring Curl",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Lie on your back, arms out to the sides, palms down.", "Rest your heels and lower legs on top of the ball, feet hip-width apart."],
  "cues": ["Hips stay up as the ball rolls.", "Pull with your hamstrings.", "Roll out slowly."],
  "prescription": {
    "reps": "8–12",
    "note": "Keep your hips up the whole set; lower them only at the end."
  },
