{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "fw-db-single-leg-rdl",
  "name": "Single-Leg Romanian Deadlift",
  "otherNames": ["Single-Leg Deadlift", "Single-Leg RDL"],
  "category": "Strength",
  "focus": "Hamstrings, glutes and balance",
  "collections": ["Free weights", "Balance"],
  "equipment": ["Dumbbells"],
  "description": "Standing on one leg with a dumbbell in each hand, hinge forward from the hip while the other leg reaches straight back, then stand up tall.",
  "source": {
    "url": "https://www.strengthlog.com/best-dumbbell-exercises-muscle-strength/",
    "title": "StrengthLog: The best dumbbell exercises"
  },
  "setup": ["Stand on one leg, knee soft, a dumbbell in each hand."],
  "cues": ["Hips level: point the back toes down.", "Back flat, weights close to your leg.", "Squeeze your glute to stand."],
  "prescription": {
    "reps": "6–10 each leg",
    "note": "Move with control: about 2 seconds each way, resting between sets as needed."
  },
  "keyframes": [
    {
      "name": "Stand on your left leg",
      "cue": "Right foot just off the floor, weights at your thighs.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [8, 0, 0],
        "shoulderR": [8, 0, 0],
        "hipR": [-5, 0, 0],
        "kneeR": 20
      }
    },
    {
      "name": "Hinge",
      "cue": "Tip forward from your hip, right leg reaching back.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "root": [70, 0, 0],
        "shoulderL": [70, 0, 0],
        "shoulderR": [70, 0, 0],
        "hipL": [70, 0, 0],
        "kneeL": 15,
        "ankleL": -12,
        "hipR": [0, 0, 0]
      }
    }
  ],
  "props": [
    {
      "type": "dumbbell",
      "hand": "handL",
      "axis": "lr"
    },
    {
      "type": "dumbbell",
      "hand": "handR",
      "axis": "lr"
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 8
  },
  "bilateral": {
    "labels": {
      "L": "Standing on the left leg",
      "R": "Standing on the right leg"
    }
  }
}
