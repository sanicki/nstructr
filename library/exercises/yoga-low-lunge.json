{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-low-lunge",
  "name": "Low Lunge",
  "otherNames": ["Anjaneyasana", "Crescent Moon Pose"],
  "category": "Hip opener",
  "focus": "Hip flexors and thighs",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {"frontThigh": 1, "glutes": 1},
  "stretches": ["frontThigh"],
  "description": "A lunge with the back knee on the floor: front knee over the ankle, hips sinking forward, arms reaching up.",
  "source": {
    "url": "https://www.yogajournal.com/poses/low-lunge/",
    "title": "Yoga Journal: Low Lunge"
  },
  "setup": ["Kneel, then step your right foot forward so the knee is over the ankle.", "Pad the back knee if it's tender."],
  "cues": ["Sink your hips forward and down.", "Front knee over the ankle.", "Reach up through your fingertips."],
  "keyframes": [
    {
      "name": "Mountain Pose",
      "cue": "Stand tall, feet together.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "pose": {}
    },
    {
      "name": "Low Lunge",
      "cue": "Right foot forward, left knee down, arms up.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["R"],
      "touch": [
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "shoulderL": [-180, 0, 0],
        "shoulderR": [-180, 0, 0],
        "hipR": [100, 0, 0],
        "kneeR": 100,
        "hipL": [-35, 0, 0],
        "kneeL": 60,
        "ankleL": 60
      }
    }
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "prescription": {
    "reps": "hold 30 seconds",
    "note": "Breathe slowly and evenly; come out of the pose if anything pinches."
  }
}
