{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-hamstring-stretch",
  "name": "Chair Hamstring Stretch",
  "otherNames": ["Seated Chair Hamstring Stretch", "Seated Single-Leg Hamstring Stretch"],
  "category": "Flexibility",
  "focus": "Back of the thighs",
  "collections": ["Stretches", "Chair-based"],
  "equipment": ["Chair"],
  "muscles": {},
  "stretches": ["backThigh"],
  "description": "Sitting near the front of a chair with one leg straight out and the heel on the floor, keep your back long and lean forward from the hips until you feel a stretch behind the thigh.",
  "source": {
    "url": "https://exrx.net/Stretches/Hamstrings/SeatedChairSingleLeg",
    "title": "ExRx: Seated Single Leg Hamstring Stretch (chair)",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Sit near the front of a sturdy chair.", "Straighten one leg out in front, heel down, toes up; the other foot flat."],
  "cues": ["Back long, chest forward.", "Hinge at the hips.", "Breathe slowly."],
  "prescription": {
    "seconds": "30",
    "note": "Fold from the hips, not the waist; stop where you feel a stretch."
  },
  "keyframes": [
    {
      "name": "Leg out",
      "cue": "Sit near the front, one leg straight out, heel on the floor.",
      "camera": 60,
      "durationMs": 1600,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["L"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 26
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 26
        }
      ],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [60, 0, 0],
        "kneeR": 0,
        "ankleR": -15
      }
    },
    {
      "name": "Lean forward",
      "cue": "Keep your back long and fold forward from the hips.",
      "camera": 60,
      "durationMs": 2400,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L"],
      "reach": [],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [60, 0, 0],
        "kneeR": 0,
        "ankleR": -15,
        "torso": [28, 0, 0],
        "neck": [-6, 0, 0],
        "shoulderL": [-3, -9.25, 0],
        "elbowL": 82,
        "shoulderR": [2, -6.25, 0],
        "elbowR": 41.5
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "z": -12
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left leg",
      "R": "Right leg"
    }
  },
  "measure": "time",
  "defaults": {
    "seconds": 30
  },
  "holdStep": 1
}
