{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "mb-around-the-world",
  "name": "Medicine Ball Around the World",
  "otherNames": ["Medicine Ball Pass Around", "Around the World with a Ball"],
  "category": "Core",
  "focus": "Core, grip and shoulders",
  "collections": ["Free weights", "Warm-up"],
  "equipment": ["Medicine ball"],
  "description": "Standing tall, pass a medicine ball from hand to hand around your waist, in front and behind, then go the other way.",
  "source": {
    "url": "https://us.physitrack.com/home-exercise-video/around-the-world",
    "title": "Physitrack: Medicine ball around the world",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Stand tall, feet hip-width apart.", "Hold a light medicine ball in front of you."],
  "cues": ["Hips and shoulders stay square.", "Pass it close to your body.", "Change direction halfway."],
  "prescription": {
    "reps": "5–10 each way",
    "note": "A light bell. Hips and shoulders face forward the whole time; only the arms move. Change direction halfway."
  },
  "keyframes": [
    {
      "name": "Pass in front",
      "cue": "Pass the bell to your right hand in front.",
      "camera": 30,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "holds": ["handL", "handR"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 4,
          "dy": 0,
          "dz": 30
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -4,
          "dy": 0,
          "dz": 30
        }
      ],
      "pose": {
        "hipL": [0, 8, 0],
        "hipR": [0, 8, 0]
      }
    },
    {
      "name": "Round the right side",
      "cue": "Right hand takes it round your right side.",
      "camera": 30,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "holds": ["handR"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 42,
          "dy": 0,
          "dz": 0
        }
      ],
      "pose": {
        "hipL": [0, 8, 0],
        "hipR": [0, 8, 0],
        "shoulderL": [0, 10, 0]
      }
    },
    {
      "name": "Pass behind",
      "cue": "Pass it to your left hand behind your back.",
      "camera": 30,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "holds": ["handL", "handR"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 4,
          "dy": 0,
          "dz": -28
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -4,
          "dy": 0,
          "dz": -28
        }
      ],
      "pose": {
        "hipL": [0, 8, 0],
        "hipR": [0, 8, 0]
      }
    },
    {
      "name": "Round the left side",
      "cue": "Left hand brings it round your left side.",
      "camera": 30,
      "durationMs": 700,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "holds": ["handL"],
      "reach": [
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -42,
          "dy": 0,
          "dz": 0
        }
      ],
      "pose": {
        "hipL": [0, 8, 0],
        "hipR": [0, 8, 0],
        "shoulderR": [0, 10, 0]
      }
    }
  ],
  "props": [
    {
      "type": "medball"
    }
  ],
  "direction": {
    "labels": {
      "A": "Clockwise",
      "B": "Counterclockwise"
    }
  },
  "measure": "reps",
