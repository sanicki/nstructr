{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-child",
  "name": "Child's Pose",
  "otherNames": ["Balasana"],
  "category": "Beginner",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Resting pose kneeling with the hips on the heels and the forehead toward the floor.",
  "source": {
    "url": "https://www.yogajournal.com/poses/child-s-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Kneel and sit your hips back toward your heels, big toes touching.", "Bring your knees together or wide, then walk your hands forward."],
  "keyframes": [
    {
      "name": "Kneel tall",
      "cue": "Kneel with the hips over the knees.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "kneeL",
      "pose": {
        "shoulderL": [-360, 0, 0],
        "shoulderR": [-360, 0, 0],
        "kneeL": 90,
        "ankleL": 90,
        "kneeR": 90,
        "ankleR": 90
      }
    },
    {
      "name": "Child's Pose",
      "cue": "Sit back on the heels and fold forward, arms reaching ahead.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "kneeL",
      "touch": [
        {
          "point": "headLow",
          "adjust": "torso"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [87, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [-194.9, 0, 0],
        "shoulderR": [-194.9, 0, 0],
        "hipL": [65, 0, 0],
        "kneeL": 155,
        "ankleL": 90,
        "hipR": [65, 0, 0],
        "kneeR": 155,
        "ankleR": 90
      }
    }
  ],
  "cues": ["Widen the knees if the belly needs room.", "Breathe into the back."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
