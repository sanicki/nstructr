{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "wall-tree",
  "name": "Tree Pose at the Wall",
  "otherNames": ["Wall Tree Pose"],
  "category": "Balancing",
  "collections": ["Yoga", "Balance"],
  "equipment": ["Wall"],
  "description": "Tree Pose with one hand on a wall for balance: stand on one leg with the other foot on your inner leg, knee out to the side.",
  "source": {
    "url": "https://www.yogajournal.com/practice/yoga-wall-poses/",
    "title": "Yoga Journal: 12 Wall Yoga Poses"
  },
  "setup": ["Stand side-on to a wall, close enough to touch it."],
  "cues": ["Hand lightly on the wall.", "Foot above or below the knee, never on it.", "Stand tall."],
  "keyframes": [
    {
      "name": "Mountain Pose",
      "cue": "Stand side-on to a wall.",
      "camera": 0,
      "durationMs": 1400,
      "holdMs": 1200,
      "phase": "setup",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [0, 6, 90],
        "shoulderR": [0, 6, 90],
        "hipR": [0, 0, 90]
      }
    },
    {
      "name": "Tree Pose at the Wall",
      "cue": "Left hand on the wall, right foot to your inner leg.",
      "camera": 0,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [0, 90, 0],
        "shoulderR": [0, 165, 90],
        "elbowR": 25,
        "hipR": [0, 70, 90],
        "kneeR": 150,
        "ankleR": -80
      },
      "reach": [
        {
          "hand": "handL",
          "to": "wall"
        }
      ]
    }
  ],
  "props": [
    {
      "type": "wall",
      "at": "handL",
      "keyframe": 1,
      "beside": true
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
