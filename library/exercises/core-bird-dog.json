{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "core-bird-dog",
  "name": "Bird Dog",
  "category": "Core",
  "focus": "Core and lower back",
  "library": "Core",
  "equipment": [],
  "description": "A stability exercise on hands and knees: reach one arm forward and the opposite leg back, hold, and return without twisting.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/14/bird-dog/",
    "title": "Bird Dog (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Start on hands and knees: hands under shoulders, knees under hips."],
  "cues": ["Keep your back flat and hips level.", "Reach long rather than high.", "Move slowly; pause at the top."],
  "prescription": {
    "reps": "6–10 each side",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
  "keyframes": [
    {
      "name": "Hands and knees",
      "cue": "Back flat.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "handL",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [75, 0, 0],
        "hipL": [75, 0, 0],
        "kneeL": 90,
        "ankleL": 90,
        "hipR": [75, 0, 0],
        "kneeR": 90,
        "ankleR": 90
      }
    },
    {
      "name": "Reach and extend",
      "cue": "Reach your right arm forward and your left leg back.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 2000,
      "phase": "rep",
      "anchor": "handL",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [165, 0, 0],
        "hipL": [-15, 0, 0],
        "hipR": [75, 0, 0],
        "kneeR": 90,
        "ankleR": 90
      }
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Right arm, left leg",
      "R": "Left arm, right leg"
    }
  },
  "measure": "reps",
  "defaults": {
    "reps": 6
  },
  "repName": "rep"
}
