      "durationMs": 2000,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "pelvis",
      "anchorZ": 60,
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        },
        {
          "point": "ankleL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "shoulderL": [90, 82, -90],
        "elbowL": 82,
        "shoulderR": [90, 82, -90],
        "elbowR": 82,
        "hipL": [6.8, 0, 0],
        "kneeL": 90,
        "ankleL": 6.8,
        "hipR": [6.8, 0, 0],
        "kneeR": 90,
        "ankleR": 6.8
      }
    },
    {
      "name": "Press",
      "cue": "Press the weights straight up.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "pelvis",
