{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "core-forearm-plank",
  "name": "Plank",
  "otherNames": ["Forearm Plank", "Front Plank", "Elbow Plank"],
  "category": "Core",
  "focus": "Core",
  "collections": ["Core"],
  "equipment": [],
  "muscles": {"shoulders": 1, "core": 3, "frontThigh": 1, "glutes": 1},
  "description": "The classic core hold: on your forearms and toes, keep your body in a straight line from head to heels.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/32/front-plank/",
    "title": "Front Plank (ACE Exercise Library)",
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Kneel on all fours, then lower onto your forearms, elbows under your shoulders."],
  "cues": ["Squeeze your glutes and brace your stomach.", "Don't let your hips sag or lift.", "Look at the floor to keep your neck long.", "Easier: keep your knees down."],
  "prescription": {
    "reps": "Hold 20–30 s, 2–3 times",
    "note": "Breathe steadily; build up the hold time gradually."
  },
  "keyframes": [
    {
      "name": "Hands and knees",
      "cue": "Start on your hands and knees.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 600,
      "phase": "setup",
      "anchor": "handR",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [75, 0, 0],
        "shoulderL": [75, 0, 0],
        "shoulderR": [75, 0, 0],
        "hipL": [75, 0, 0],
