        "ankleL": 90,
        "hipR": [75, 0, 0],
        "kneeR": 90,
        "ankleR": 90
      }
    },
    {
      "name": "Lower to the forearms",
      "quiet": true,
      "camera": 90,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "setup",
      "anchor": "kneeL",
      "touch": [
        {
          "point": "kneeR",
          "adjust": "hipR"
        },
        {
          "point": "kneeL",
          "adjust": "hipL"
        }
