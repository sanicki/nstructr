{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-hip-circles",
  "name": "Chair-Supported Hip Circles",
  "otherNames": ["Standing Hip Circles with a Chair"],
  "category": "Mobility",
  "focus": "Hips and lower back",
  "collections": ["Warm-up", "Chair-based"],
  "equipment": ["Chair"],
  "description": "Standing behind a chair with your hands on its back, circle your hips slowly: forward, to one side, back and to the other side.",
  "source": {
    "url": "https://www.onemedical.com/blog/exercise-fitness/hip-strengthening-exercises-for-seniors/",
    "title": "One Medical: Hip strengthening exercises for seniors",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Stand behind a sturdy chair, hands on its back.", "Feet shoulder-width apart, knees soft."],
  "cues": ["Big, slow circles.", "Shoulders stay quiet.", "Change direction halfway."],
  "prescription": {
    "reps": "10 each direction",
    "note": "About 30 seconds. From the front you see the side-to-side part of each circle; the compass shows where your hips are."
  },
