{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bar-hanging-knee-raise",
  "name": "Hanging Knee Raise",
  "otherNames": ["Hanging Knee Tuck", "Hanging Knee Lift"],
  "category": "Strength",
  "focus": "Core (lower abs) and hip flexors",
  "collections": ["Core", "Bodyweight"],
  "equipment": ["Pull-up bar"],
  "description": "Hanging from a bar, lift your knees to hip height by curling your pelvis up, then lower them slowly without swinging.",
  "source": {
    "url": "https://www.strengthlog.com/hanging-knee-raise/",
    "title": "StrengthLog: Hanging Knee Raise"
  },
  "setup": ["A sturdy pull-up bar you can reach with a small hop or a step.", "Grip it shoulder-width, palms forward."],
  "cues": ["Shoulders active, not shrugged.", "Curl your hips up.", "Lower slowly."],
  "prescription": {
    "reps": "8–12",
    "note": "Lower your legs slowly so you don't swing. Easier: one knee at a time."
  },
  "keyframes": [
