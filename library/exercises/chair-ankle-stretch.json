{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-ankle-stretch",
  "name": "Seated Ankle Stretch",
  "otherNames": ["Ankle Point and Flex"],
  "category": "Mobility",
  "focus": "Ankles",
  "collections": ["Chair-based"],
  "equipment": ["Chair"],
  "description": "Improves ankle flexibility and helps circulation: with one leg straightened off the floor, point the toes away and then pull them back toward you.",
  "source": {
    "url": "https://www.nhs.uk/live-well/exercise/sitting-exercises/",
    "title": "NHS: sitting exercises (ankle stretch)",
    "note": "Stick-figure approximation."
  },
  "setup": ["Sit upright on a solid chair, holding the sides of the seat."],
  "cues": ["Keep the raised leg straight.", "Point your toes away, then pull them back toward you.", "Move slowly through the full range."],
  "prescription": {
    "reps": "2 sets of 5 each foot",
    "note": "Also helps lower the risk of developing a blood clot. Do these exercises at least twice a week."
  },
  "keyframes": [
    {
      "name": "Sit tall",
      "cue": "Hands on the sides of the seat, feet flat.",
      "camera": 90,
      "durationMs": 1400,
      "holdMs": 500,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Straighten your left leg",
      "cue": "Lift your left foot and straighten the leg.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [97, 0, 0],
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Point your toes",
      "cue": "Point your toes away from you.",
      "camera": 90,
      "durationMs": 1200,
      "holdMs": 1200,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [97, 0, 0],
        "ankleL": 62,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "Toes toward you",
      "cue": "Pull your toes back toward you.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1200,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 12
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 12
        }
      ],
      "pose": {
        "shoulderL": [-14.6, 0, 0],
        "elbowL": 45.8,
        "shoulderR": [-14.6, 0, 0],
        "elbowR": 45.8,
        "hipL": [97, 0, 0],
        "ankleL": -22,
        "hipR": [90, 0, 0],
        "kneeR": 90
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "z": -12
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Left foot",
      "R": "Right foot"
    }
  },
  "measure": "reps",
  "defaults": {
    "reps": 2
  },
  "repName": "rep"
}
