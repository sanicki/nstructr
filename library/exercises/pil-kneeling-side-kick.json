{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "pil-kneeling-side-kick",
  "name": "Kneeling Side Kick",
  "otherNames": ["Pilates Kneeling Side Kick"],
  "category": "Pilates",
  "focus": "Hips, waist and balance",
  "collections": ["Pilates"],
  "equipment": ["Yoga mat"],
  "muscles": {"shoulders": 1, "core": 2, "frontThigh": 1, "glutes": 3},
  "description": "Kneeling, lean over onto one hand under your shoulder with the other hand behind your head, lift the top leg to hip height, then kick it forward and sweep it back behind you.",
  "source": {
    "url": "https://onlinepilatesclasses.com/blog/the-original-34-classical-pilates-mat-exercises/",
    "title": "Online Pilates Classes: The original 34 classical Pilates mat exercises",
    "note": "Classic Pilates mat exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Kneel up tall.", "Lean to one side and put that hand down under your shoulder; other hand behind your head.", "Lift the top leg straight out to hip height."],
  "cues": ["Hips stacked.", "Leg level with the hip.", "Waist lifted off the floor."],
  "prescription": {
    "reps": "6 each side",
    "note": "Keep the hips stacked; the kick comes from the hip, not the back."
  },
