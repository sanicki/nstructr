        "hipR": [0, 60, 0],
        "kneeR": 90,
        "ankleR": 90,
        "shoulderR": [0, 70, 0],
        "shoulderL": [0, 150, 0],
        "elbowL": 140,
        "hipL": [0, 20, 0]
      }
    },
    {
      "name": "Kick forward",
      "cue": "Kick the top leg forward.",
      "camera": 30,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "kneeR",
      "pose": {
        "root": [0, 70, 0],
        "neck": [0, -20, 0],
        "hipR": [0, 60, 0],
        "kneeR": 90,
        "ankleR": 90,
        "shoulderR": [0, 70, 0],
        "shoulderL": [0, 150, 0],
        "elbowL": 140,
        "hipL": [70, 20, 0]
