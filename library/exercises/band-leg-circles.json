    "url": "https://gophysiotherapy.co.uk/pilates-with-resistance-band/",
    "title": "Go Physiotherapy: Pilates with a resistance band",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Lie on your back, one leg long on the floor.", "Loop a band round the other foot, an end in each hand, and lift that leg up."],
  "cues": ["Hips still.", "Small circles.", "Keep the band taut."],
  "prescription": {
    "reps": "5 each direction, each leg",
    "note": "Breathe out as the leg circles down, in as it comes back up."
  },
