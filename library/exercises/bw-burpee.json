{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bw-burpee",
  "name": "Burpee",
  "otherNames": ["Squat Thrust Jump"],
  "category": "Cardio",
  "focus": "Whole body (cardio)",
  "collections": ["Bodyweight", "Warm-up"],
  "description": "Squat and put your hands on the floor, jump your feet back to a plank, jump them back in, then jump up with your arms overhead and land softly.",
  "source": {
    "url": "https://www.nasm.org/resource-center/exercise-library/squat-thrust-burpees",
    "title": "NASM Exercise Library: Squat Thrust Burpees"
  },
  "setup": ["Stand with your feet shoulder-width apart, with room in front of and behind you."],
  "cues": ["Hands under your shoulders in the plank; hips level.", "Land softly, knees bent.", "Keep a steady rhythm."],
  "prescription": {
    "reps": "5–15",
    "note": "For less impact, step back and in one foot at a time and rise onto your toes instead of jumping. Some versions add a push-up in the plank."
  },
  "keyframes": [
