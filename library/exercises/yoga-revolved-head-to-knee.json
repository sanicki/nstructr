{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-revolved-head-to-knee",
  "name": "Revolved Head-to-Knee Pose",
  "otherNames": ["Parivrtta Janu Sirsasana"],
  "category": "Seated",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Seated side bend over one straight leg with the top arm reaching overhead.",
  "source": {
    "url": "https://www.yogajournal.com/poses/revolved-head-to-knee-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit with your legs wide apart.", "Bend one knee and bring that foot to the inner thigh of the straight leg."],
  "keyframes": [
    {
      "name": "Sit with legs wide",
      "cue": "Sit tall with both legs stretched out to the sides.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 900,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR.side"
        },
        {
          "point": "handL",
          "adjust": "shoulderL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 23.9, 0],
        "shoulderR": [0, 23.9, 0],
        "hipL": [90, 90, 90],
        "hipR": [0, 90, 0]
      }
    },
    {
      "name": "Fold the left leg in",
      "cue": "Bend the left knee and bring the foot to the inner right thigh.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 600,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR.side"
        },
        {
          "point": "handL",
          "adjust": "shoulderL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 23.9, 0],
        "shoulderR": [0, 23.9, 0],
        "hipL": [90, 45, 90],
        "kneeL": 140,
        "ankleL": -90,
        "hipR": [0, 90, 0]
      }
    },
    {
      "name": "Revolved Head-to-Knee",
      "cue": "Side-bend toward the right leg and reach the left arm overhead.",
      "camera": 0,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "pose": {
        "torso": [0, 60, 0],
        "shoulderL": [0, 160, 0],
        "shoulderR": [0, 150, 0],
        "hipL": [90, 45, 90],
        "kneeL": 140,
        "ankleL": -90,
        "hipR": [0, 90, 0]
      }
    },
    {
      "name": "Fold the left leg in",
      "cue": "Come back up to sitting tall.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 600,
      "phase": "finish",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR.side"
        },
        {
          "point": "handL",
          "adjust": "shoulderL.side"
        }
      ],
      "pose": {
        "shoulderL": [0, 23.9, 0],
        "shoulderR": [0, 23.9, 0],
        "hipL": [90, 45, 90],
        "kneeL": 140,
        "ankleL": -90,
        "hipR": [0, 90, 0]
      }
    }
  ],
  "cues": ["Turn the chest up toward the ceiling.", "Keep both sit bones down."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 2,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
