{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "wu-inchworm",
  "name": "Inchworm",
  "otherNames": ["Inchworms", "Walkout"],
  "category": "Mobility",
  "focus": "Hamstrings, core and shoulders",
  "collections": ["Warm-up"],
  "equipment": [],
  "muscles": {"shoulders": 2, "chest": 1, "triceps": 1, "core": 2},
  "stretches": ["backThigh", "lowerLegs"],
  "description": "From standing, fold forward to put your hands on the floor, walk them out to a plank, then walk them back in and stand up.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/254/inchworms/",
    "title": "ACE Exercise Library: Inchworms"
  },
  "setup": ["Stand with your feet together or slightly apart."],
  "cues": ["Bend your knees as much as you need.", "Small hand steps.", "Keep your core firm in the plank."],
  "keyframes": [
    {
      "name": "Stand tall",
      "cue": "Feet together.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {}
    },
    {
      "name": "Hands to the floor",
      "cue": "Fold forward and put your hands on the floor.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [140, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [185, 0, 0],
        "shoulderR": [185, 0, 0],
        "kneeL": 12,
        "kneeR": 12
      }
    },
    {
      "name": "Walk out to a plank",
      "cue": "Walk your hands forward to a plank.",
      "camera": 90,
      "durationMs": 2500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "toeL",
      "touch": [
        {
          "point": "handR",
          "adjust": "root"
        }
      ],
      "pose": {
        "root": [66, 0, 0],
        "shoulderL": [66, 0, 0],
        "shoulderR": [66, 0, 0],
        "hipL": [-8, 0, 0],
        "ankleL": 24,
        "hipR": [-8, 0, 0],
        "ankleR": 24
      }
    },
    {
      "name": "Walk back in",
      "cue": "Walk your hands back to your feet.",
      "camera": 90,
      "durationMs": 2500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [140, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [185, 0, 0],
        "shoulderR": [185, 0, 0],
        "kneeL": 12,
        "kneeR": 12
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
  "prescription": {
    "reps": "5–8",
    "note": "Move slowly and smoothly, within a comfortable range."
  }
}
