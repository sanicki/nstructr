{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "wu-inchworm",
  "name": "Inchworm",
  "otherNames": ["Inchworms", "Walkout"],
  "category": "Mobility",
  "focus": "Hamstrings, core and shoulders",
  "collections": ["Warm-up"],
  "equipment": [],
  "muscles": {"shoulders": 2, "chest": 1, "triceps": 1, "core": 2},
  "stretches": ["backThigh", "lowerLegs"],
  "description": "From standing, fold forward to put your hands on the floor, walk them out to a plank, then walk them back in and stand up.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/254/inchworms/",
    "title": "ACE Exercise Library: Inchworms"
  },
  "setup": ["Stand with your feet together or slightly apart."],
  "cues": ["Bend your knees as much as you need.", "Small hand steps.", "Keep your core firm in the plank."],
  "keyframes": [
    {
      "name": "Stand tall",
      "cue": "Feet together.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {}
    },
    {
      "name": "Hands to the floor",
      "cue": "Fold forward and put your hands on the floor.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [140, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [185, 0, 0],
        "shoulderR": [185, 0, 0],
        "kneeL": 12,
        "kneeR": 12
      }
    },
    {
      "name": "Walk your hands out",
      "cue": "Walk your hands forward, one at a time.",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [29.5, 0, 0],
        "torso": [92.25, 0, 0],
        "hipL": [-1.5, 0, 0],
        "hipR": [-1.5, 0, 0],
        "shoulderL": [105.75, 0, 0],
        "shoulderR": [140, 0, 0],
        "ankleL": 8,
        "ankleR": 8,
        "neck": [10, 0, 0]
      }
    },
    {
      "name": "Left hand forward",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [34, 0, 0],
        "torso": [85, 0, 0],
        "hipL": [0, 0, 0],
        "hipR": [0, 0, 0],
        "shoulderL": [133, 0, 0],
        "shoulderR": [133, 0, 0],
        "ankleL": 10,
        "ankleR": 10,
        "neck": [10, 0, 0]
      },
      "quiet": true
    },
    {
      "name": "Right hand forward",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [46, 0, 0],
        "torso": [54.25, 0, 0],
        "hipL": [-7.25, 0, 0],
        "hipR": [-7.25, 0, 0],
        "shoulderL": [81, 0, 0],
        "shoulderR": [118.5, 0, 0],
        "ankleL": 16,
        "ankleR": 16,
        "neck": [10, 0, 0]
      },
      "quiet": true
    },
    {
      "name": "Plank",
      "cue": "Body in one straight line, hands under your shoulders.",
      "camera": 90,
      "durationMs": 900,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "toeL",
      "touch": [
        {
          "point": "handR",
          "adjust": "root"
        }
      ],
      "pose": {
        "root": [66, 0, 0],
        "shoulderL": [66, 0, 0],
        "shoulderR": [66, 0, 0],
        "hipL": [-8, 0, 0],
        "ankleL": 24,
        "hipR": [-8, 0, 0],
        "ankleR": 24
      }
    },
    {
      "name": "Walk back in",
      "cue": "Walk your hands back toward your feet, one at a time.",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [46, 0, 0],
        "torso": [54.25, 0, 0],
        "hipL": [-7.25, 0, 0],
        "hipR": [-7.25, 0, 0],
        "shoulderL": [118.5, 0, 0],
        "shoulderR": [81, 0, 0],
        "ankleL": 16,
        "ankleR": 16,
        "neck": [10, 0, 0]
      }
    },
    {
      "name": "Left hand back",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [34, 0, 0],
        "torso": [85, 0, 0],
        "hipL": [0, 0, 0],
        "hipR": [0, 0, 0],
        "shoulderL": [133, 0, 0],
        "shoulderR": [133, 0, 0],
        "ankleL": 10,
        "ankleR": 10,
        "neck": [10, 0, 0]
      },
      "quiet": true
    },
    {
      "name": "Right hand back",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 100,
      "phase": "rep",
      "anchor": "toeL",
      "pose": {
        "root": [29.5, 0, 0],
        "torso": [92.25, 0, 0],
        "hipL": [-1.5, 0, 0],
        "hipR": [-1.5, 0, 0],
        "shoulderL": [140, 0, 0],
        "shoulderR": [105.75, 0, 0],
        "ankleL": 8,
        "ankleR": 8,
        "neck": [10, 0, 0]
      },
      "quiet": true
    },
    {
      "name": "Hands by your feet",
      "cue": "Hands back by your feet.",
      "camera": 90,
      "durationMs": 800,
      "holdMs": 200,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "torso": [140, 0, 0],
        "neck": [10, 0, 0],
        "shoulderL": [185, 0, 0],
        "shoulderR": [185, 0, 0],
        "kneeL": 12,
        "kneeR": 12
      },
      "quiet": true
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
  "prescription": {
    "reps": "5–8",
    "note": "Move slowly and smoothly, within a comfortable range."
  }
