    {
      "name": "Bring your left foot in",
      "cue": "Bring your left foot in to meet it.",
      "camera": 0,
      "durationMs": 500,
      "holdMs": 200,
      "phase": "rep",
      "anchor": "ankleR",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [-27.5, 0, 0],
        "elbowL": 69.4,
        "shoulderR": [-27.5, 0, 0],
        "elbowR": 69.4,
