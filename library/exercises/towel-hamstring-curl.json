  "id": "towel-hamstring-curl",
  "name": "Towel Hamstring Curl",
  "otherNames": ["Slider Hamstring Curl", "Sliding Leg Curl"],
  "category": "Strength",
  "focus": "Hamstrings, glutes and core",
