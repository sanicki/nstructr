{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "band-glute-bridge",
  "name": "Banded Glute Bridge",
  "otherNames": ["Resistance Band Glute Bridge"],
  "category": "Strength",
  "focus": "Glutes and hamstrings",
  "collections": ["Resistance band"],
  "equipment": ["Resistance band"],
  "muscles": {"lowerBack": 1, "core": 1, "glutes": 3, "backThigh": 2},
  "description": "A glute bridge with a loop band just above your knees: press your knees out against the band as you lift your hips.",
  "source": {
    "url": "https://www.muscleandstrength.com/exercises/banded-glute-bridge",
    "title": "Muscle & Strength: Banded Glute Bridge"
  },
  "setup": ["Lie on your back, knees bent, feet flat and hip-width apart.", "Put a loop band just above your knees."],
  "cues": ["Press your knees out against the band.", "Lift your hips until shoulders, hips and knees line up.", "Lower slowly."],
  "prescription": {
    "reps": "10–15",
    "note": "Keep pressing out against the band the whole time. About 2 seconds up and 2 seconds down."
  },
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Knees bent, band above your knees.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 400,
      "phase": "rep",
      "anchor": "neckBase",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [58, 8, 0],
        "kneeL": 116,
        "ankleL": 32,
        "hipR": [58, 8, 0],
        "kneeR": 116,
        "ankleR": 32
      }
    },
    {
      "name": "Lift your hips",
      "cue": "Press your knees out and lift your hips.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 1000,
      "phase": "rep",
      "anchor": "neckBase",
      "plant": ["L", "R"],
      "keep": ["ankleL", "ankleR", "handL", "handR"],
      "pose": {
        "root": [-150, 0, 0],
        "chest": [50, 0, 0],
        "neck": [50, 0, 0],
        "shoulderL": [-11.1, 0, 0],
        "elbowL": 1.6,
        "shoulderR": [-11.3, 0, 0],
        "elbowR": 1.6,
        "hipL": [-44.9, 8, 0],
        "kneeL": 80.5,
        "ankleL": 24.6,
        "hipR": [-44.9, 8, 0],
        "kneeR": 80.5,
        "ankleR": 24.6
      }
    }
  ],
  "props": [
    {
      "type": "band",
      "from": "kneeL",
      "to": "kneeR"
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 8
  },
  "repName": "rep"
}
