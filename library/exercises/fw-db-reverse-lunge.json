      "cue": "Drive through your front heel and step back in.",
      "camera": 90,
      "durationMs": 1600,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [0, 6, 0],
        "shoulderR": [0, 6, 0],
        "hipL": [8, 0, 0],
        "kneeL": 10,
        "ankleL": -2,
        "hipR": [-10, 0, 0],
