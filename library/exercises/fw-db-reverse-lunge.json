  "setup": ["Stand tall with feet hip-width apart.", "Hold a dumbbell in each hand at your sides."],
  "cues": ["Step back onto the ball of your foot.", "Lower straight down, chest tall.", "Push through the front heel to come back."],
  "prescription": {
    "reps": "8–12 each leg",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
