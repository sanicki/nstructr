      "cue": "Shift onto your left leg and lift your right foot.",
      "camera": 90,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "shoulderL": [0, 6, 0],
        "shoulderR": [0, 6, 0],
        "hipL": [8, 0, 0],
        "kneeL": 10,
        "ankleL": -2,
        "hipR": [-10, 0, 0],
        "kneeR": 55,
        "ankleR": 20
      }
    },
    {
      "name": "Step back and lower",
      "cue": "Step back and bend both knees, arms hanging.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "touch": [
        {
          "point": "toeR",
