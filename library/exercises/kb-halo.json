{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "kb-halo",
  "name": "Kettlebell Halo",
  "otherNames": ["Halo"],
  "category": "Mobility",
  "focus": "Shoulders, upper back and core",
  "collections": ["Free weights"],
  "equipment": ["Kettlebell"],
  "description": "Holding a kettlebell by the horns in front of your chest, circle it slowly around your head, close to it, then the other way.",
  "source": {
    "url": "https://www.acefitness.org/resources/everyone/exercise-library/394/halo/",
    "title": "Halo (ACE Exercise Library)",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Stand tall, feet hip-width apart.", "Hold the bell by the horns in front of your chest."],
  "cues": ["Keep the bell close to your head.", "Ribs down; don't arch your back.", "Slow and smooth."],
  "prescription": {
    "reps": "5–8 each way",
    "note": "A light bell. Keep it close to your head and your ribs down."
  },
  "keyframes": [
    {
      "name": "In front",
      "cue": "The bell in front of your chest.",
      "camera": 0,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderR": [20, -10, -30],
        "elbowR": 140,
        "shoulderL": [20, -10, -30],
        "elbowL": 140
      }
    },
    {
      "name": "Right side",
      "cue": "Beside your right ear.",
      "camera": 0,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderR": [100, 20, 0],
        "elbowR": 150,
        "shoulderL": [90, -30, -45],
        "elbowL": 130
      }
    },
    {
      "name": "Behind",
      "cue": "Behind your head.",
      "camera": 0,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderR": [160, -10, -30],
        "elbowR": 150,
        "shoulderL": [160, -10, -30],
        "elbowL": 150
      }
    },
    {
      "name": "Left side",
      "cue": "Beside your left ear.",
      "camera": 0,
      "durationMs": 900,
      "holdMs": 0,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderR": [90, -30, -45],
        "elbowR": 130,
        "shoulderL": [100, 20, 0],
        "elbowL": 150
      }
    }
  ],
  "props": [
    {
      "type": "kettlebell",
      "hands": ["handL", "handR"]
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 5
  },
  "repName": "circle",
  "direction": {
    "labels": {
      "A": "To the right first",
      "B": "To the left first"
    }
  }
}
