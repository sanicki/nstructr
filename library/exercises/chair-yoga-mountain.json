{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "chair-yoga-mountain",
  "name": "Seated Mountain Pose",
  "otherNames": ["Chair Mountain Pose", "Seated Tadasana"],
  "category": "Flexibility",
  "collections": ["Yoga", "Chair-based"],
  "equipment": ["Chair"],
  "description": "Sitting tall near the front of a chair, feet flat and hip-width apart, hands resting on the thighs: lengthen up through the crown of your head and breathe.",
  "source": {
    "url": "https://www.yogajournal.com/poses/chair-yoga-poses/",
    "title": "Yoga Journal: Chair yoga poses",
    "note": "Described in our own words. Stick-figure approximation."
  },
  "setup": ["Sit near the front of a sturdy chair.", "Feet flat, hip-width apart; knees over the ankles."],
  "cues": ["Crown of the head up.", "Shoulders soft, away from your ears.", "Breathe slowly."],
  "keyframes": [
    {
      "name": "Sit",
      "cue": "Sit near the front of the seat, feet flat.",
      "camera": 60,
      "durationMs": 1600,
      "phase": "setup",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 26
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 26
        }
      ],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90,
        "torso": [8, 0, 0]
      }
    },
    {
      "name": "Seated Mountain Pose",
      "cue": "Sit tall, crown of the head up, shoulders relaxed.",
      "camera": 60,
      "durationMs": 2400,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["L", "R"],
      "reach": [
        {
          "hand": "handR",
          "to": "pelvis",
          "dx": 22,
          "dz": 26
        },
        {
          "hand": "handL",
          "to": "pelvis",
          "dx": -22,
          "dz": 26
        }
      ],
      "touch": [
        {
          "point": "ankleL",
          "adjust": "kneeL"
        },
        {
          "point": "ankleR",
          "adjust": "kneeR"
        }
      ],
      "pose": {
        "hipL": [90, 0, 0],
        "kneeL": 90,
        "hipR": [90, 0, 0],
        "kneeR": 90,
        "neck": [0, 0, 0]
      }
    }
  ],
  "props": [
    {
      "type": "chair",
      "back": "behind",
      "z": -12
    }
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "prescription": {
    "seconds": "30",
    "note": "Breathe slowly; feel your feet on the floor and your seat on the chair."
  }
}
