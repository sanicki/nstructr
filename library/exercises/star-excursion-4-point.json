{
  "$schema": "../../schema/exercise.schema.json",
  "version": 1,
  "id": "star-excursion-4-point",
  "name": "4-Point Star Excursion",
  "category": "Balance",
  "equipment": [],
  "description": "A simpler star excursion: balancing on one leg, reach the other foot forward, out to the side, straight back and across behind, tapping the floor lightly and coming back to the middle each time.",
  "source": {
    "note": "Four-direction version of the Star Excursion Balance exercise in this library. In clinical terms the reaches are anterior, medial, posterior and lateral."
  },
  "setup": [
    "Stand on one leg with the knee slightly bent, hands on your hips.",
    "Picture a plus sign on the floor around your standing foot: forward, back and both sides."
  ],
  "cues": [
    "Keep the standing heel down the whole time.",
    "Tap the floor lightly with your toes; don't put weight on the reaching foot.",
    "Bend the standing knee to reach further, but stay in control.",
    "Come back to the middle between every reach, without putting the foot down."
  ],
  "prescription": {
    "rounds": 3,
    "sides": "both",
    "note": "The video description doesn't state reps; three rounds per leg is a common starting point."
  },
  "facing": "right",
  "anchorX": 40,
  "bilateral": {
    "labels": {
      "L": "Left leg",
      "R": "Right leg"
    }
  },
  "floorGuide": {
    "type": "star",
    "arms": 4
  },
