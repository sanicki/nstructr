{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-marichi-3",
  "name": "Pose Dedicated to the Sage Marichi III",
  "otherNames": ["Marichyasana III"],
  "category": "Hip-Opening",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "description": "Seated twist with one knee up and the torso turning toward it.",
  "source": {
    "url": "https://www.yogajournal.com/poses/marichi-s-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Sit tall with both legs straight out in front of you.", "Bend one knee and plant that foot near your sitting bone, beside the straight leg's inner thigh."],
  "keyframes": [
    {
      "name": "Sit in Staff Pose",
      "cue": "Sit tall with the legs straight out in front.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "pelvis",
      "touch": [
        {
          "point": "handR",
          "adjust": "shoulderR"
        },
        {
          "point": "handL",
          "adjust": "shoulderL"
        }
      ],
      "pose": {
        "shoulderL": [-23.9, 0, 0],
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [90, 0, 0]
      }
    },
    {
      "name": "Marichyasana III",
      "cue": "Bend the right knee, hook the left elbow outside it, and twist right.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "pelvis",
      "plant": ["R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "handR",
          "adjust": "shoulderR"
        }
      ],
      "pose": {
        "shoulderL": [45, 0, 0],
        "elbowL": 90,
        "shoulderR": [-23.9, 0, 0],
        "hipL": [90, 0, 0],
        "hipR": [130, 0, 0],
        "kneeR": 120,
        "ankleR": -40
      }
    }
  ],
  "cues": ["Sit tall on both sit bones.", "Twist on the exhale."],
  "bilateral": {
    "labels": {
      "L": "Left side",
      "R": "Right side"
    }
  },
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
