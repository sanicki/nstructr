{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bw-good-morning",
  "name": "Bodyweight Good Morning",
  "otherNames": ["Good Morning"],
  "category": "Strength",
  "focus": "Hamstrings and glutes",
  "collections": ["Bodyweight"],
  "equipment": [],
  "description": "A hip hinge with no weight, hands behind your head: push your hips back with soft knees until your hamstrings stretch, then stand up.",
  "source": {
    "url": "https://www.issaonline.com/blogs/training-tips/how-to-do-the-good-morning-exercise-and-why-you-should",
    "title": "ISSA: How to do the good morning exercise"
  },
  "setup": ["Stand with feet hip-width apart, knees soft.", "Hands lightly behind your head, elbows wide."],
  "cues": ["Push your hips back.", "Back flat, chest proud.", "Squeeze your glutes to stand."],
  "prescription": {
    "reps": "10–15",
    "note": "Only go as far as your back stays flat. About 2 seconds down and 2 seconds up."
  },
  "keyframes": [
    {
      "name": "Stand tall",
      "cue": "Hands behind your head, knees soft.",
      "camera": 90,
      "durationMs": 2000,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "shoulderL": [150, 40, 0],
        "shoulderR": [150, 40, 0],
        "elbowL": 150,
        "elbowR": 150
      }
    },
    {
      "name": "Hinge",
      "cue": "Push your hips back, back flat.",
      "camera": 90,
      "durationMs": 2200,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "pose": {
        "torso": [72, 0, 0],
        "shoulderL": [150, 40, 0],
        "shoulderR": [150, 40, 0],
        "hipL": [18, 0, 0],
        "kneeL": 22,
        "ankleL": -4,
        "hipR": [18, 0, 0],
        "kneeR": 22,
        "ankleR": -4,
        "elbowL": 150,
        "elbowR": 150
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 8
  },
  "repName": "rep"
}
