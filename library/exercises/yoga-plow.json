{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "yoga-plow",
  "name": "Plow Pose",
  "otherNames": ["Halasana"],
  "category": "Inversion",
  "collections": ["Yoga"],
  "equipment": ["Yoga mat"],
  "muscles": {},
  "stretches": ["upperBack", "lowerBack", "backThigh"],
  "description": "Inversion on the shoulders with the legs lowered over the head.",
  "source": {
    "url": "https://www.yogajournal.com/poses/plow-pose/",
    "title": "Yoga Journal Pose Library",
    "note": "Stick-figure approximation. Twists and binds can't be fully shown in 2D."
  },
  "setup": ["Lie on your back with your arms by your sides, palms down; a folded blanket under your shoulders protects your neck.", "Bend your knees in toward your chest."],
  "keyframes": [
    {
      "name": "Lie on your back",
      "cue": "Lie down with the knees bent and feet flat.",
      "camera": 90,
      "durationMs": 1500,
      "holdMs": 1000,
      "phase": "setup",
      "anchor": "neckBase",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "kneeR"
        },
        {
          "point": "ankleL",
          "adjust": "kneeL"
        }
      ],
      "pose": {
        "root": [-90, 0, 0],
        "neck": [34, 0, 0],
        "hipL": [45, 0, 0],
        "kneeL": 90,
        "ankleL": 45,
        "hipR": [45, 0, 0],
        "kneeR": 90,
        "ankleR": 45
      }
    },
    {
      "name": "Plow Pose",
      "cue": "Lift the hips over the shoulders and lower the feet behind the head.",
      "camera": 90,
      "durationMs": 2600,
      "holdMs": 5000,
      "phase": "rep",
      "anchor": "neckBase",
      "touch": [
        {
          "point": "toeR",
          "adjust": "hipR"
        },
        {
          "point": "toeL",
          "adjust": "hipL"
        }
      ],
      "pose": {
        "root": [-180, 0, 0],
        "neck": [124, 0, 0],
        "shoulderL": [-90, 0, 0],
        "shoulderR": [-90, 0, 0],
        "hipL": [120.4, 0, 0],
        "hipR": [120.4, 0, 0]
      }
    }
  ],
  "cues": ["Keep the neck still; don't turn the head.", "Rest the feet on a block if they don't reach."],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
