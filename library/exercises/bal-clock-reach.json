{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "bal-clock-reach",
  "name": "Clock Reach",
  "otherNames": ["Clock Arm Reach"],
  "category": "Balance",
  "focus": "Balance and core",
  "collections": ["Balance"],
  "equipment": [],
  "description": "Standing on one leg, reach one arm to 12, 3 and 6 o'clock on an imaginary clock and back, keeping your balance.",
  "source": {
    "url": "https://eat-move-save.extension.illinois.edu/move/exercise/clock-reach",
    "title": "University of Illinois Extension: Clock Reach"
  },
  "setup": ["Stand next to a sturdy chair you can hold.", "Imagine standing in the middle of a clock face."],
  "cues": ["Standing knee soft.", "Move the arm slowly.", "Touch the chair if you wobble."],
  "prescription": {
    "reps": "3–5 rounds each side",
    "note": "Move slowly and smoothly, within a comfortable range."
  },
  "keyframes": [
    {
      "name": "Stand on your left leg",
      "cue": "Lift your right foot, knee bent.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "setup",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "hipR": [30, 0, 0],
        "kneeR": 90
      }
    },
    {
      "name": "12 o'clock",
      "cue": "Reach your right arm straight up.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "hipR": [30, 0, 0],
        "kneeR": 90,
        "shoulderR": [0, 170, 90]
      }
    },
    {
      "name": "3 o'clock",
      "cue": "Reach it out to the side.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "hipR": [30, 0, 0],
        "kneeR": 90,
        "shoulderR": [0, 90, 0]
      }
    },
    {
      "name": "6 o'clock",
      "cue": "Reach it down and back behind you.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "hipR": [30, 0, 0],
        "kneeR": 90,
        "shoulderR": [-40, 20, 0]
      }
    },
    {
      "name": "Back to the middle",
      "cue": "Arm down.",
      "camera": 0,
      "durationMs": 1500,
      "holdMs": 300,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L"],
      "pose": {
        "hipR": [30, 0, 0],
        "kneeR": 90
      }
    }
  ],
  "measure": "reps",
  "defaults": {
    "reps": 3
  },
  "repName": "round",
  "bilateral": {
    "labels": {
      "L": "Standing on the left leg",
      "R": "Standing on the right leg"
    }
  }
}
