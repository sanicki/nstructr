{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "pil-hip-twist",
  "name": "Hip Twist",
  "otherNames": ["Hip Twist with Stretched Arms", "Hip Circles (Pilates)"],
  "category": "Pilates",
  "focus": "Core and obliques",
  "collections": ["Pilates"],
  "equipment": ["Mat"],
  "muscles": {"shoulders": 1, "triceps": 1, "core": 3, "frontThigh": 2},
  "description": "Sitting back on your hands with your legs straight up together, circle both legs to one side, down, round to the other side and back up, keeping the chest lifted.",
  "source": {
    "url": "https://onlinepilatesclasses.com/blog/the-original-34-classical-pilates-mat-exercises/",
    "title": "Online Pilates Classes: The original 34 classical Pilates mat exercises",
    "note": "Classic Pilates mat exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": ["Sit and lean back on your hands, arms straight, fingers pointing back.", "Lift both legs straight up together."],
  "cues": ["Chest lifted, shoulders down.", "Legs together.", "Circle from the hips."],
  "prescription": {
    "reps": "3 each way",
    "note": "Chest lifted; small circles to start."
  },
