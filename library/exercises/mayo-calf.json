{
  "$schema": "../../schema/exercise.schema.json",
  "version": 2,
  "id": "mayo-calf",
  "name": "Calf Stretch",
  "category": "Stretch",
  "focus": "Calves",
  "collections": ["Stretches"],
  "equipment": ["Wall"],
  "description": "Stretches the calf along the back of the lower leg: hands on a wall, one foot back with the heel down, bend the front knee.",
  "source": {
    "url": "https://www.mayoclinic.org/healthy-lifestyle/fitness/in-depth/stretching/art-20546848",
    "title": "Mayo Clinic: A guide to basic stretches",
    "note": "Stick-figure approximation."
  },
  "setup": ["Stand an arm's length from a wall or sturdy support.", "Put your right foot behind your left."],
  "cues": ["Keep the back knee straight and the back heel on the floor.", "Back straight, hips forward.", "Point both feet straight ahead.", "Deeper: bend the back knee slightly as you lean in."],
  "prescription": {
    "reps": "2–4 each side",
    "note": "Hold about 30 seconds and repeat 2 to 4 times on each side. Warm up for 5 to 10 minutes first, move slowly, don't bounce, and back off if it hurts."
  },
  "keyframes": [
    {
      "name": "Hands on the wall",
      "cue": "Arms straight to the wall, right foot back.",
      "camera": 90,
      "durationMs": 1800,
      "holdMs": 800,
      "phase": "setup",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "pose": {
        "shoulderL": [90, 0, 0],
        "shoulderR": [90, 0, 0]
      }
    },
    {
      "name": "Lean in",
      "cue": "Bend your left knee forward, right heel down, back straight.",
      "camera": 90,
      "durationMs": 2400,
      "holdMs": 30000,
      "phase": "rep",
      "anchor": "ankleL",
      "plant": ["L", "R"],
      "touch": [
        {
          "point": "ankleR",
          "adjust": "hipR"
        }
      ],
      "reach": [
        {
          "hand": "handR",
          "to": "wall"
        },
        {
          "hand": "handL",
          "to": "wall"
        }
      ],
      "pose": {
        "torso": [12, 0, 0],
        "shoulderL": [101.2, 0, 0],
        "elbowL": 1.6,
        "shoulderR": [101.2, 0, 0],
        "elbowR": 1.6,
        "hipL": [30, 0, 0],
        "kneeL": 42,
        "ankleL": -12,
        "hipR": [-22.8, 0, 0],
        "ankleR": -22.8
      }
    }
  ],
  "bilateral": {
    "labels": {
      "L": "Right calf",
      "R": "Left calf"
    }
  },
  "props": [
    {
      "type": "wall",
      "at": "handR",
      "keyframe": 0
    }
  ],
  "measure": "time",
  "holdStep": 1,
  "defaults": {
    "seconds": 30
  },
  "repName": "rep"
}
