  "id": "step-up",
  "name": "Step-Up",
  "category": "Strength",
  "focus": "Thighs and glutes",
  "library": "Bodyweight",
  "equipment": [
    "Step"
  ],
  "description": "Leg strength and balance: step up onto a low step with one foot, bring the other foot up, then step back down one foot at a time.",
  "source": {
    "note": "Standard exercise, described in our own words for this library. Stick-figure approximation."
  },
  "setup": [
    "Stand facing a sturdy step or the bottom stair, hands on your hips.",
    "Hold a rail or wall if you need support."
  ],
  "cues": [
    "Put your whole foot on the step.",
    "Push through the heel of the leading leg to step up.",
    "Stand tall at the top.",
    "Step down with control, leading with the same foot."
  ],
  "prescription": {
    "reps": "8–12 each leg",
    "note": "Move slowly: about 2 seconds to lift or push and 2 seconds to lower, resting between exercises as needed."
  },
