{
  "$schema": "../../schema/workout.schema.json",
  "version": 2,
  "id": "beginner-free-weights-20",
  "name": "20-Minute Beginner's Free Weights",
  "description": "A full-body dumbbell workout for beginners, about 20 minutes, in a small space: one set each of two variations of most moves (goblet and dumbbell squats, rows and reverse flys, Romanian and regular deadlifts, overhead presses and lateral raises, two triceps moves), two sets of chest presses and curls, lunges, then glute bridges and a dead bug. Start light; you should finish each set with two or three reps to spare.",
  "blocks": [
    {
      "name": "Legs, chest and back",
      "items": [
        {
          "ex": "fw-goblet-squat",
          "reps": 10
        },
        {
          "ex": "fw-db-squat",
          "reps": 10
        },
        {
          "ex": "fw-db-floor-press",
          "reps": 10,
          "sets": 2
        },
        {
          "ex": "fw-db-row",
          "reps": 10
        },
        {
          "ex": "fw-db-reverse-fly",
          "reps": 10
        },
        {
          "ex": "fw-db-rdl",
          "reps": 10
        },
        {
          "ex": "fw-db-deadlift",
          "reps": 10
        }
      ]
    },
    {
      "name": "Shoulders and arms",
      "items": [
        {
          "ex": "fw-db-press",
          "reps": 10
        },
        {
          "ex": "fw-db-lateral",
          "reps": 10
        },
        {
          "ex": "fw-db-reverse-lunge",
          "reps": 8,
          "sides": "alternate"
        },
        {
          "ex": "fw-db-curl",
          "reps": 10,
          "sets": 2
        },
        {
          "ex": "fw-db-overhead-triceps",
          "reps": 10
        },
        {
          "ex": "fw-db-kickback",
          "reps": 10
        }
      ]
    },
    {
      "name": "Finish",
      "items": [
        {
          "ex": "fw-db-glute-bridge",
          "reps": 12
        },
        {
          "ex": "fw-db-dead-bug",
          "reps": 6,
          "sides": "alternate"
        }
      ]
    }
  ]
}
