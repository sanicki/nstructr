{
  "$schema": "../../schema/workout.schema.json",
  "version": 2,
  "id": "beginner-yoga-20",
  "name": "20-Minute Beginner's Yoga",
  "description": "A gentle first yoga practice, about 20 minutes, with nothing but a mat: settle in, warm up the spine, a few standing poses held for 35 seconds each side, then floor poses and a rest at the end.",
  "blocks": [
    {
      "name": "Arrive and warm up",
      "items": [
        {
          "ex": "yoga-easy",
          "seconds": 45
        },
        {
          "ex": "yoga-cat-cow",
          "reps": 6
        },
        {
          "ex": "yoga-child",
          "seconds": 35
        },
        {
          "ex": "yoga-downward-dog",
          "seconds": 35
        }
      ]
    },
    {
      "name": "Standing poses",
      "items": [
        {
          "ex": "yoga-mountain",
          "seconds": 30
        },
        {
          "ex": "yoga-standing-forward-bend",
          "seconds": 35
        },
        {
          "ex": "yoga-low-lunge",
          "seconds": 35,
          "sides": "both"
        },
        {
          "ex": "yoga-warrior-2",
          "seconds": 35,
          "sides": "both"
        },
        {
          "ex": "yoga-triangle",
          "seconds": 35,
          "sides": "both"
        },
        {
          "ex": "yoga-tree",
          "seconds": 35,
          "sides": "both"
        }
      ]
    },
    {
      "name": "On the floor",
      "items": [
        {
          "ex": "yoga-sphinx",
          "seconds": 35
        },
        {
          "ex": "yoga-bridge",
          "seconds": 30
        },
        {
          "ex": "yoga-seated-forward-bend",
          "seconds": 35
        },
        {
          "ex": "yoga-happy-baby",
          "seconds": 35
        },
        {
          "ex": "yoga-supine-twist",
          "seconds": 35,
          "sides": "both"
        },
        {
          "ex": "yoga-corpse",
          "seconds": 90
        }
      ]
    }
  ]
}
