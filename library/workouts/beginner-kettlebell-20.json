{
  "$schema": "../../schema/workout.schema.json",
  "version": 2,
  "id": "beginner-kettlebell-20",
  "name": "20-Minute Beginner's Kettlebell",
  "description": "A full-body workout with one kettlebell for beginners, about 20 minutes: a halo and goblet squats to warm up, the deadlift, Romanian deadlift and swing, a row and press for each arm, lunges and sumo squats, then a carry and twists. Start with a light bell.",
  "blocks": [
    {
      "name": "Warm up",
      "items": [
        {
          "ex": "kb-halo",
          "reps": 5,
          "dir": "both"
        },
        {
          "ex": "fw-kb-goblet-squat",
          "reps": 8
        }
      ]
    },
    {
      "name": "Hinge",
      "items": [
        {
          "ex": "fw-kb-deadlift",
          "reps": 6,
          "sets": 2
        },
        {
          "ex": "kb-romanian-deadlift",
          "reps": 8,
          "sets": 2
        },
        {
          "ex": "fw-kb-swing",
          "reps": 10,
          "sets": 2
        }
      ]
    },
    {
      "name": "Upper body",
      "items": [
        {
          "ex": "kb-single-arm-row",
          "reps": 8,
          "sides": "both",
          "sets": 2
        },
        {
          "ex": "kb-overhead-press",
          "reps": 6,
          "sides": "both",
          "sets": 2
        }
      ]
    },
    {
      "name": "Legs",
      "items": [
        {
          "ex": "kb-goblet-reverse-lunge",
          "reps": 6,
          "sides": "alternate",
          "sets": 2
        },
        {
          "ex": "kb-sumo-squat",
          "reps": 10,
          "sets": 2
        }
      ]
    },
    {
      "name": "Finish",
      "items": [
        {
          "ex": "kb-suitcase-carry",
          "reps": 15,
          "sides": "both"
        },
        {
          "ex": "kb-russian-twist",
          "reps": 12
        }
      ]
    }
  ]
}
