{
  "$schema": "../../schema/workout.schema.json",
  "version": 2,
  "id": "beginner-kettlebell-20",
  "name": "20-Minute Beginner's Kettlebell",
  "description": "A full-body workout with one kettlebell for beginners, about 20 minutes, in a small space: a halo, around the world and goblet squats to warm up, the deadlift, Romanian deadlift and swing, a row and press for each arm, lunges, sumo and goblet squats, then twists. Start with a light bell.",
  "blocks": [
    {
      "name": "Warm up",
      "items": [
        {
          "ex": "kb-halo",
          "reps": 6,
          "dir": "both"
        },
        {
          "ex": "kb-around-the-world",
          "reps": 5,
          "dir": "both"
        },
        {
          "ex": "fw-kb-goblet-squat",
          "reps": 8
        }
      ]
    },
    {
      "name": "Hinge",
      "items": [
        {
          "ex": "fw-kb-deadlift",
          "reps": 6,
          "sets": 2
        },
        {
          "ex": "kb-romanian-deadlift",
          "reps": 8,
          "sets": 2
        },
        {
          "ex": "fw-kb-swing",
          "reps": 12,
          "sets": 3
        }
      ]
    },
    {
      "name": "Upper body",
      "items": [
        {
          "ex": "kb-single-arm-row",
          "reps": 8,
          "sets": 2,
          "sides": "both"
        },
        {
          "ex": "kb-overhead-press",
          "reps": 6,
          "sets": 2,
          "sides": "both"
        }
      ]
    },
    {
      "name": "Legs",
      "items": [
        {
          "ex": "kb-goblet-reverse-lunge",
          "reps": 6,
          "sets": 2,
          "sides": "alternate"
        },
        {
          "ex": "kb-sumo-squat",
          "reps": 10,
          "sets": 2
        },
        {
          "ex": "fw-kb-goblet-squat",
          "reps": 8,
          "sets": 2
        }
      ]
    },
    {
      "name": "Finish",
      "items": [
        {
          "ex": "kb-russian-twist",
          "reps": 12,
          "sets": 2
        }
      ]
    }
  ]
}
