{
  "$schema": "../../schema/workout.schema.json",
  "version": 2,
  "id": "beginner-resistance-band-20",
  "name": "20-Minute Beginner's Resistance Band",
  "description": "A full-body workout with one resistance band for beginners, about 20 minutes, in a small space: pull-aparts and standing hip abductions to warm up, squats, deadlifts, bridges and clamshells, two kinds of row, chest press and fly, overhead press and lateral raise, then curls and two triceps moves. Pick a light band; you should finish each set with two or three reps to spare.",
  "blocks": [
    {
      "name": "Warm up",
      "items": [
        {
          "ex": "bhf-pull-apart",
          "reps": 12
        },
        {
          "ex": "bhf-abduction",
          "reps": 10,
          "sides": "both"
        }
      ]
    },
    {
      "name": "Legs and glutes",
      "items": [
        {
          "ex": "bhf-squat",
          "reps": 12
        },
        {
          "ex": "band-rdl",
          "reps": 12
        },
        {
          "ex": "band-glute-bridge",
          "reps": 12
        },
        {
          "ex": "band-clamshell",
          "reps": 10,
          "sides": "both"
        }
      ]
    },
    {
      "name": "Back, chest and shoulders",
      "items": [
        {
          "ex": "band-seated-row",
          "reps": 12
        },
        {
          "ex": "band-bent-over-row",
          "reps": 12
        },
        {
          "ex": "bhf-chest-press",
          "reps": 10
        },
        {
          "ex": "band-chest-fly",
          "reps": 10
        },
        {
          "ex": "band-overhead-press",
          "reps": 10
        },
        {
          "ex": "bhf-lateral-raise",
          "reps": 10
        }
      ]
    },
    {
      "name": "Arms",
      "items": [
        {
          "ex": "bhf-bicep-curl",
          "reps": 10,
          "sets": 2
        },
        {
          "ex": "band-overhead-triceps",
          "reps": 10
        },
        {
          "ex": "band-triceps-kickback",
          "reps": 10
        }
      ]
    }
  ]
}
