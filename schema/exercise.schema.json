{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exercise.schema.json",
  "title": "NstructR exercise",
  "description": "One exercise (format v2): metadata, instructions, equipment drawn with the figure, and the keyframes the figure moves through. Poses are 3D joint angles in degrees: ball joints (root, torso, chest, neck, shoulders, hips) take [forward, side, turn]; knees, elbows and ankles one number. See the in-app format reference and docs/3d-skeleton.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "keyframes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, unique. Exercises made by users start with u-."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "otherNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Other names people use for it (a Sanskrit name, a gym name). Search finds them; the first is shown under the name."
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Collections it is shown in (Bodyweight, Yoga, ...). Library exercises only; one or more."
    },
    "category": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "basedOn": {
      "type": "string",
      "description": "For a user's copy of a library exercise: the id it was copied from."
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prescription": {
      "type": "object",
      "properties": {
        "reps": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "measure": {
      "enum": [
        "reps",
        "time"
      ]
    },
    "repName": {
      "type": "string"
    },
    "holdStep": {
      "type": "integer",
      "minimum": 0
    },
    "defaults": {
      "type": "object",
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "bilateral": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "properties": {
            "L": {
              "type": "string"
            },
            "R": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "direction": {
      "type": "object",
      "required": [
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "required": [
            "A",
            "B"
          ],
          "properties": {
            "A": {
              "type": "string"
            },
            "B": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "travel": {
      "type": "boolean",
      "description": "Moves across the floor (walking lunge, band walk): each rep carries on from where the last one ended; the view follows the figure over a marked floor"
    },
    "floorGuide": {
      "type": "object",
      "properties": {
        "type": {
          "const": "star"
        },
        "arms": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/keyframe"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "keyframe": {
      "type": "object",
      "required": [
        "pose"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "cue": {
          "type": "string"
        },
        "camera": {
          "type": "number",
          "description": "Camera, in degrees around the vertical: 90 = side view (the figure faces screen-right), 0 = front view. Default 90."
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "holdMs": {
          "type": "number",
          "minimum": 0
        },
        "ease": {
          "enum": [
            "smooth",
            "linear"
          ]
        },
        "phase": {
          "enum": [
            "setup",
            "rep",
            "finish"
          ]
        },
        "quiet": {
          "type": "boolean"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "pelvis",
            "spine",
            "neckBase",
            "head",
            "headTop",
            "headLow",
            "hipL",
            "hipR",
            "kneeL",
            "kneeR",
            "ankleL",
            "ankleR",
            "toeL",
            "toeR",
            "footL",
            "footR",
            "shoulderL",
            "shoulderR",
            "elbowL",
            "elbowR",
            "handL",
            "handR",
            "armpitL",
            "armpitR",
            "backL",
            "backR"
          ]
        },
        "anchorY": {
          "type": "number",
          "description": "Hanging: the height the anchor (a hand on a pull-up bar) is held at, instead of on the floor."
        },
        "anchorX": {
          "type": "number",
          "description": "Where the anchor is pinned, sideways (+ = the figure's right), from the stage centre."
        },
        "anchorZ": {
          "type": "number",
          "description": "Where the anchor is pinned, forward (+) or back, from the stage centre."
        },
        "lift": {
          "type": "number"
        },
        "plant": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "L",
              "R"
            ]
          }
        },
        "touch": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "point",
              "adjust"
            ],
            "properties": {
              "point": {
                "type": "string",
                "enum": [
                  "pelvis",
                  "spine",
                  "neckBase",
                  "head",
                  "headTop",
                  "headLow",
                  "hipL",
                  "hipR",
                  "kneeL",
                  "kneeR",
                  "ankleL",
                  "ankleR",
                  "toeL",
                  "toeR",
                  "footL",
                  "footR",
                  "shoulderL",
                  "shoulderR",
                  "elbowL",
                  "elbowR",
                  "handL",
                  "handR",
                  "armpitL",
                  "armpitR",
                  "backL",
                  "backR",
                  "thighL",
                  "thighR",
                  "shinL",
                  "shinR",
                  "back",
                  "sideL",
                  "sideR"
                ],
                "description": "A body point, or a segment (thighL/R, shinL/R, back: pelvis to neck, sideL/R: hip to shoulder) that rests where it is lowest over what's under it, e.g. a shin across a foam roller."
              },
              "adjust": {
                "type": "string",
                "pattern": "^((root|torso|chest|neck|shoulderL|shoulderR|hipL|hipR)(\\.(forward|side|turn))?|elbowL|elbowR|kneeL|ankleL|kneeR|ankleR)$"
              },
              "gap": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "reach": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hand",
              "to"
            ],
            "properties": {
              "hand": {
                "type": "string",
                "enum": [
                  "handL",
                  "handR"
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "pelvis",
                      "spine",
                      "neckBase",
                      "head",
                      "headTop",
                      "headLow",
                      "hipL",
                      "hipR",
                      "kneeL",
                      "kneeR",
                      "ankleL",
                      "ankleR",
                      "toeL",
                      "toeR",
                      "footL",
                      "footR",
                      "shoulderL",
                      "shoulderR",
                      "elbowL",
                      "elbowR",
                      "handL",
                      "handR",
                      "armpitL",
                      "armpitR",
                      "backL",
                      "backR"
                    ]
                  },
                  {
                    "enum": [
                      "wall",
                      "chair"
                    ]
                  }
                ]
              },
              "dx": {
                "type": "number"
              },
              "dy": {
                "type": "number"
              },
              "dz": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "keep": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "ankleL",
                  "ankleR",
                  "handL",
                  "handR"
                ]
              },
              {
                "type": "object",
                "required": [
                  "point",
                  "keyframe"
                ],
                "properties": {
                  "point": {
                    "enum": [
                      "ankleL",
                      "ankleR",
                      "handL",
                      "handR"
                    ]
                  },
                  "keyframe": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "guide": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "pose": {
          "type": "object",
          "description": "Joint angles. Ball joints [forward, side, turn]; hinges one number. Missing joints are 0.",
          "properties": {
            "root": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "torso": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "chest": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "neck": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "shoulderL": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "elbowL": {
              "type": "number"
            },
            "shoulderR": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "elbowR": {
              "type": "number"
            },
            "hipL": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "kneeL": {
              "type": "number"
            },
            "ankleL": {
              "type": "number"
            },
            "hipR": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "kneeR": {
              "type": "number"
            },
            "ankleR": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "holds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "enum": [
                  "handL",
                  "handR",
                  "ankleL",
                  "ankleR"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "description": "What holds the weight or ball in this step: hands (a kettlebell passed from hand to hand, Around the World: [\"handR\"], or both at the pass), the ankles (a stability ball passed from the hands to the feet), or a spot {x, y, z} it was thrown to (a medicine ball against a wall). Between steps it moves from one to the other."
        }
      },
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "band",
            "towel",
            "wall",
            "chair",
            "bench",
            "step",
            "dumbbell",
            "kettlebell",
            "barbell",
            "bar",
            "strap",
            "block",
            "ring",
            "ball",
            "roller",
            "medball"
          ]
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restLength": {
          "type": "number"
        },
        "at": {
          "type": "string",
          "enum": [
            "pelvis",
            "spine",
            "neckBase",
            "head",
            "headTop",
            "headLow",
            "hipL",
            "hipR",
            "kneeL",
            "kneeR",
            "ankleL",
            "ankleR",
            "toeL",
            "toeR",
            "footL",
            "footR",
            "shoulderL",
            "shoulderR",
            "elbowL",
            "elbowR",
            "handL",
            "handR",
            "armpitL",
            "armpitR",
            "backL",
            "backR"
          ]
        },
        "keyframe": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "back": {
          "enum": [
            "behind",
            "ahead"
          ]
        },
        "backHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hand": {
          "type": "string",
          "enum": [
            "handL",
            "handR"
          ]
        },
        "hands": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "handL",
              "handR",
              "ankleL",
              "ankleR"
            ]
          },
          "description": "The hands holding a weight. A stability ball with \"hands\" is carried, not lain on: what can hold it (the ankles too), with each step's \"holds\" saying who has it."
        },
        "axis": {
          "enum": [
            "lr",
            "fb",
            "ud"
          ]
        },
        "z": {
          "type": "number"
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beside": {
          "type": "boolean"
        },
        "y": {
          "type": "number",
          "description": "Pull-up bar: its height above the floor (385: a doorway bar, just above a standing reach)."
        },
        "length": {
          "type": "number",
          "description": "Yoga strap: its length (it doesn't stretch); default its longest route in the exercise plus a grip, the rest hanging from the hands. Foam roller: its length side to side (160: 90 cm)."
        },
        "r": {
          "type": "number",
          "description": "Stability ball: its radius (58: a 65 cm ball). Foam roller: its radius (14: 15 cm across)."
        },
        "rolls": {
          "type": "boolean",
          "description": "Stability ball: it rolls along the floor under what rests on it (the heels curling it in), moving as far as the point on it does."
        }
      },
      "additionalProperties": false
    }
  }
}
